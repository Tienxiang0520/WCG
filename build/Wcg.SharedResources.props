<Project>
  <!-- Both hosts must embed the same historical catalogs and translations with stable names. -->
  <ItemGroup>
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../WcgWeb/Data/balance-before-rules-simplification.json" LogicalName="WcgWeb.Balance.BeforeRulesSimplification" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../WcgWeb/Data/balance-before-ability-pp.json" LogicalName="WcgWeb.Balance.BeforeAbilityPp" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../WcgWeb/Data/balance-before-dual-will.json" LogicalName="WcgWeb.Balance.BeforeDualWill" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../WcgWeb/Data/balance-before-shield-counter.json" LogicalName="WcgWeb.Balance.BeforeShieldCounter" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../WcgWeb/Data/balance-before-cost-up.json" LogicalName="WcgWeb.Balance.BeforeCostUp" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../WcgWeb/Data/balance-before-shield-pp.json" LogicalName="WcgWeb.Balance.BeforeShieldPp" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../WcgWeb/Data/balance-before-reason-buff.json" LogicalName="WcgWeb.Balance.BeforeReasonBuff" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../WcgWeb/Data/balance-before-silence-spell.json" LogicalName="WcgWeb.Balance.BeforeSilenceSpell" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../WcgWeb/Data/balance-before-deflation.json" LogicalName="WcgWeb.Balance.BeforeDeflation" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../WcgWeb/Data/balance-before-strong-build-adjustment.json" LogicalName="WcgWeb.Balance.BeforeStrongBuildAdjustment" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../WcgWeb/Data/balance-before-october-13.json" LogicalName="WcgWeb.Balance.BeforeOctoberBalance" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../WcgWeb/Data/balance-before-energy-shield.json" LogicalName="WcgWeb.Balance.BeforeEnergyShield" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../WcgWeb/Data/balance-before-damage-counters.json" LogicalName="WcgWeb.Balance.BeforeDamageCounters" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../WcgWeb/Data/balance-before-player-targets.json" LogicalName="WcgWeb.Balance.BeforePlayerTargets" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../WcgWeb/Data/balance-before-unlimited-faction-triggers.json" LogicalName="WcgWeb.Balance.BeforeUnlimitedFactionTriggers" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../WcgWeb/Data/balance-before-arrow-cards.json" LogicalName="WcgWeb.Balance.BeforeArrowCards" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../WcgWeb/Data/balance-before-card-text.json" LogicalName="WcgWeb.Balance.BeforeCardText" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../WcgWeb/Data/balance-before-diversity.json" LogicalName="WcgWeb.Balance.BeforeDiversity" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../WcgWeb/i18n/en.json" LogicalName="WcgWeb.I18n.en.json" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../WcgWeb/i18n/cards.en.json" LogicalName="WcgWeb.I18n.cards.en.json" WithCulture="false" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../WcgWeb/i18n/decks.en.json" LogicalName="WcgWeb.I18n.decks.en.json" WithCulture="false" />
  </ItemGroup>
</Project>
