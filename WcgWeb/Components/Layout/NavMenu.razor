@implements IDisposable
@inject PlayerProfileStore Profile
<div class="top-row navbar navbar-dark">
    <a class="navbar-brand" href="" aria-label="@L["魂誓首頁"]">
        <span class="brand-mark" aria-hidden="true"><WcgWeb.Components.Common.Icon Name="sigil" Size="22" /></span>
        <span class="brand-text"><b>@L["魂誓"]</b><small>SOUL OATH</small></span>
    </a>
    <button class="sidebar-toggle" type="button" @onclick="OnToggle"
            aria-label="@(Collapsed ? "展開側邊欄" : "收合側邊欄")"
            aria-expanded="@(!Collapsed ? "true" : "false")" aria-controls="main-navigation"
            title="@(Collapsed ? "展開側邊欄" : "收合側邊欄")"><WcgWeb.Components.Common.Icon Name="@(Collapsed ? "chevron-right" : "chevron-left")" Size="16" /></button>
    <button class="mobile-toggle" type="button" @onclick="ToggleMobileMenu"
            aria-label="@(mobileMenuOpen ? "收合選單" : "展開選單")"
            aria-expanded="@(mobileMenuOpen ? "true" : "false")" aria-controls="main-navigation"><WcgWeb.Components.Common.Icon Name="@(mobileMenuOpen ? "close" : "menu")" Size="22" /></button>
</div>

<div id="main-navigation" class="nav-scrollable @(mobileMenuOpen ? "mobile-open" : "")">
    <nav class="nav flex-column" aria-label="@L["主選單"]">
        @foreach (var item in menuItems)
        {
            <div class="nav-item">
                <NavLink class="nav-link" href="@item.Href" Match="@item.Match" title="@item.Label"
                         aria-label="@item.Label" @onclick="CloseMobileMenu">
                    <span class="nav-icon" aria-hidden="true"><WcgWeb.Components.Common.Icon Name="@item.Icon" Size="19" /></span>
                    <span class="nav-label">@item.Label</span>
                    @if (item.Href == "tutorial") { <span class="nav-badge @(TutorialDone == TutorialTotal ? "complete" : "")" aria-label="@($"教學已完成 {TutorialDone} / {TutorialTotal} 課")">@TutorialDone/@TutorialTotal</span> }
                </NavLink>
            </div>
        }
    </nav>
    <p class="nav-footer"><span>v0.6</span><span>@L["五大意志 · 單人卡牌對戰"]</span></p>
</div>

@code {
    [Parameter] public bool Collapsed { get; set; }
    private static int TutorialTotal => WcgWeb.Services.Tutorial.TutorialLessons.All.Count;
    private int TutorialDone => WcgWeb.Services.Tutorial.TutorialLessons.All.Count(l => Profile.TutorialDone(l.Id));
    protected override void OnInitialized() => Profile.Changed += ProfileChanged;
    private void ProfileChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Profile.Changed -= ProfileChanged;
    [Parameter] public EventCallback OnToggle { get; set; }
    private bool mobileMenuOpen;
    private void ToggleMobileMenu() => mobileMenuOpen = !mobileMenuOpen;
    private void CloseMobileMenu() => mobileMenuOpen = false;
    private readonly (string Href, string Icon, string Label, NavLinkMatch Match)[] menuItems =
    [
        ("", "swords", "訓練場", NavLinkMatch.All),
        ("tutorial", "school", "教學", NavLinkMatch.Prefix),
        ("ranked", "trophy", "天梯", NavLinkMatch.Prefix),
        ("deckbuilder", "cards", "牌組構築室", NavLinkMatch.Prefix),
        ("cards", "book", "完整卡牌圖鑑", NavLinkMatch.Prefix),
        ("rules", "scroll", "官方遊戲規則", NavLinkMatch.Prefix),
        ("settings", "gear", "設定", NavLinkMatch.Prefix)
    ];
}
