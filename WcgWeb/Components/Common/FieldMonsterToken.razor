@namespace WcgWeb.Components.Common

<div class="field-monster-card will-@Monster.Card.Will @(CanAttack ? "can-attack" : "") @(IsSelected ? "is-attacking" : "") @(Monster.HasAttacked || Monster.HasSummoningSickness ? "is-exhausted" : "")"
     @onclick="HandleClick">

    <!-- Top: Name & Will -->
    <div class="d-flex justify-content-between align-items-center mb-1">
        <span class="card-title" style="font-size:0.75rem;" title="@Monster.Card.Name">
            @Monster.Card.Name
        </span>
        <span style="font-size:0.7rem;">@CardItem.GetWillIcon(Monster.Card.Will)</span>
    </div>

    <!-- Center: Monster Art & Status Badges -->
    <div class="card-art-box my-1" style="height: 60px;">
        <CardArt Card="Monster.Card" />
        @if (Monster.IsTaunt)
        {
            <div class="position-absolute top-0 end-0 p-1">
                <span class="badge bg-secondary shadow-sm" style="font-size:0.6rem;">@L["🛡️嘲諷"]</span>
            </div>
        }
    </div>

    <!-- Keyword Chips & Triggers -->
    <div class="d-flex flex-wrap gap-1 justify-content-center mb-1" style="min-height: 18px;">
        @if (Monster.HasCharge) { <span class="badge bg-danger p-1" style="font-size:0.55rem;">@L["衝鋒"]</span> }
        @if (Monster.HasTrample) { <span class="badge bg-warning text-dark p-1" style="font-size:0.55rem;">@L["貫穿"]</span> }
        @if (Monster.HasPoison) { <span class="badge bg-success p-1" style="font-size:0.55rem;">@L["劇毒"]</span> }
        @if (Monster.HasSummoningSickness && !Monster.HasCharge) { <span class="badge bg-dark text-muted p-1" style="font-size:0.55rem;">@L["💤失調"]</span> }
        @if (Monster.HasAttacked) { <span class="badge bg-secondary p-1" style="font-size:0.55rem;">@L["已攻擊"]</span> }
    </div>

    <!-- Bottom: PP & DP -->
    <div class="card-footer-stats mt-auto">
        <div class="stat-badge-pp @(Monster.CurrentPP > (Monster.Card.PP ?? 0) ? "bg-success border-success" : (Monster.CurrentPP < (Monster.Card.PP ?? 0) ? "bg-dark border-danger" : ""))"
             title="@L.F("戰鬥力量值 PP：{0}", Monster.CurrentPP)">
            ⚔️ @Monster.CurrentPP
        </div>
        <div class="stat-badge-dp" title="@L.F("玩家傷害值 DP：{0}", Monster.CurrentDP)">
            ❤️ @Monster.CurrentDP
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public MonsterInstance Monster { get; set; } = null!;
    [Parameter] public bool CanAttack { get; set; } = false;
    [Parameter] public bool IsSelected { get; set; } = false;
    [Parameter] public EventCallback OnMonsterClicked { get; set; }

    private async Task HandleClick()
    {
        if (OnMonsterClicked.HasDelegate)
        {
            await OnMonsterClicked.InvokeAsync();
        }
    }
}
