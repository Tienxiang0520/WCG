@page "/cards"
@inject CardDatabase CardDb

<PageTitle>卡牌圖鑑 - 魂誓</PageTitle>

<div class="container-fluid py-3 gallery-page">
    <header class="page-hero compact">
        <div class="page-hero-text">
            <p class="eyebrow"><WcgWeb.Components.Common.Icon Name="book" Size="14" />完整卡牌圖鑑</p>
            <h1>五大意志 · @CardDb.AllCards.Count 張卡牌</h1>
        </div>
        <label class="search-field large">
            <WcgWeb.Components.Common.Icon Name="search" Size="18" />
            <input type="text" class="form-control" aria-label="搜尋卡片"
                   placeholder="搜尋名稱、效果或卡牌編號…"
                   @bind="SearchText" @bind:event="oninput" />
        </label>
    </header>
    <div class="card bg-dark text-white border-secondary mb-4 shadow filter-card">
        <div class="card-body py-3 filter-panel">
            <!-- Will Filters -->
            <div class="d-flex flex-wrap gap-1 align-items-center mb-2 filter-row">
                <span class="filter-label">意志</span>
                <button class="filter-chip @(SelectedWill == "" ? "on" : "")" aria-pressed="@(SelectedWill == "" ? "true" : "false")" @onclick='() => SelectedWill = ""'>全部 <small>@CardDb.AllCards.Count</small></button>
                <button class="filter-chip will-chip will-wrath @(SelectedWill == "狂怒" ? "on" : "")" aria-pressed="@(SelectedWill == "狂怒" ? "true" : "false")" @onclick='() => SelectedWill = "狂怒"'><i class="will-dot"></i>狂怒 <small>@CardDb.AllCards.Count(c => c.Will == "狂怒")</small></button>
                <button class="filter-chip will-chip will-reason @(SelectedWill == "理智" ? "on" : "")" aria-pressed="@(SelectedWill == "理智" ? "true" : "false")" @onclick='() => SelectedWill = "理智"'><i class="will-dot"></i>理智 <small>@CardDb.AllCards.Count(c => c.Will == "理智")</small></button>
                <button class="filter-chip will-chip will-vitality @(SelectedWill == "生機" ? "on" : "")" aria-pressed="@(SelectedWill == "生機" ? "true" : "false")" @onclick='() => SelectedWill = "生機"'><i class="will-dot"></i>生機 <small>@CardDb.AllCards.Count(c => c.Will == "生機")</small></button>
                <button class="filter-chip will-chip will-order @(SelectedWill == "秩序" ? "on" : "")" aria-pressed="@(SelectedWill == "秩序" ? "true" : "false")" @onclick='() => SelectedWill = "秩序"'><i class="will-dot"></i>秩序 <small>@CardDb.AllCards.Count(c => c.Will == "秩序")</small></button>
                <button class="filter-chip will-chip will-abyss @(SelectedWill == "深淵" ? "on" : "")" aria-pressed="@(SelectedWill == "深淵" ? "true" : "false")" @onclick='() => SelectedWill = "深淵"'><i class="will-dot"></i>深淵 <small>@CardDb.AllCards.Count(c => c.Will == "深淵")</small></button>
                <button class="filter-chip will-chip will-neutral @(SelectedWill == "中立" ? "on" : "")" aria-pressed="@(SelectedWill == "中立" ? "true" : "false")" @onclick='() => SelectedWill = "中立"'><i class="will-dot"></i>中立 <small>@CardDb.AllCards.Count(c => c.Will == "中立")</small></button>
            </div>

            <!-- Type Filters & Keyword Filters -->
            <div class="d-flex flex-wrap gap-1 align-items-center filter-row">
                <span class="filter-label">類型</span>
                <button class="filter-chip @(SelectedType == "" ? "on" : "")" aria-pressed="@(SelectedType == "" ? "true" : "false")" @onclick='() => SelectedType = ""'>全部</button>
                <button class="filter-chip @(SelectedType == "怪物" ? "on" : "")" aria-pressed="@(SelectedType == "怪物" ? "true" : "false")" @onclick='() => SelectedType = "怪物"'>怪物 <small>@CardDb.AllCards.Count(c => c.Type == "怪物")</small></button>
                <button class="filter-chip @(SelectedType == "法術" ? "on" : "")" aria-pressed="@(SelectedType == "法術" ? "true" : "false")" @onclick='() => SelectedType = "法術"'>法術 <small>@CardDb.AllCards.Count(c => c.IsSpell)</small></button>
                <button class="filter-chip @(SelectedType == "結界" ? "on" : "")" aria-pressed="@(SelectedType == "結界" ? "true" : "false")" @onclick='() => SelectedType = "結界"'>結界 <small>@CardDb.AllCards.Count(c=>c.IsEnchantment)</small></button>

                <div class="vr mx-2"></div>
                <span class="filter-label">關鍵字</span>
                @foreach (var kw in new[] { "嘲諷", "衝鋒", "貫穿", "劇毒", "聖盾", "箭頭", "反擊", "沉默" })
                {
                    string k = kw;
                    <button class="filter-chip @(SelectedKeyword == k ? "on" : "")" aria-pressed="@(SelectedKeyword == k ? "true" : "false")"
                            @onclick="() => ToggleKeyword(k)">@k</button>
                }
            </div>
        </div>
    </div>

    <!-- Cards Gallery Grid -->
    <div class="d-flex flex-wrap gap-3 justify-content-center p-2 card-grid">
        @if (FilteredCards.Count == 0)
        {
            <div class="text-center py-5 text-muted">
                <h4>沒有找到匹配的卡牌</h4>
                <p>請嘗試清除關鍵字或更換篩選條件</p>
            </div>
        }
        else
        {
            @foreach (var card in FilteredCards)
            {
                <div class="gallery-entry" @key="card.Id">
                    <WcgWeb.Components.Common.CardItem Card="@card" OnCardClicked="() => Inspect = card" />
                    <div class="gallery-id">#@card.Id</div>
                </div>
            }
        }
    </div>
</div>

@if (Inspect is { } inspected)
{
    <div class="card-detail-backdrop" @onclick="() => Inspect = null">
        <section class="card-detail" role="dialog" aria-modal="true" aria-label="卡片詳情" @onclick:stopPropagation="true">
            <h2>@inspected.Name</h2>
            <WcgWeb.Components.Common.CardArt Card="inspected" CssClass="detail-illustration" />
            <p>@inspected.Id · @inspected.Type · @inspected.TotalCost 通用費用</p>
            @if (inspected.IsMonster) { <p>@inspected.PP PP · @inspected.DP DP</p> }
            <p>@(string.IsNullOrWhiteSpace(inspected.Text) ? "無異能" : inspected.Text)</p>
            <button class="btn btn-primary" @onclick="() => Inspect = null">關閉詳情</button>
        </section>
    </div>
}

@code {
    private CardDefinition? Inspect;
    private string SearchText { get; set; } = "";
    private string SelectedWill { get; set; } = "";
    private string SelectedType { get; set; } = "";
    private string SelectedKeyword { get; set; } = "";

    private void ToggleKeyword(string kw)
    {
        SelectedKeyword = SelectedKeyword == kw ? "" : kw;
    }

    private List<CardDefinition> FilteredCards
    {
        get
        {
            var list = CardDb.AllCards.AsEnumerable();

            if (!string.IsNullOrEmpty(SelectedWill))
                list = list.Where(c => c.Will == SelectedWill);

            if (!string.IsNullOrEmpty(SelectedType))
                list = list.Where(c => (SelectedType=="法術"?c.IsSpell:c.Type == SelectedType));

            if (!string.IsNullOrEmpty(SelectedKeyword))
            {
                list = list.Where(c => c.Text.Contains(SelectedKeyword) ||
                                       (SelectedKeyword == "嘲諷" && c.HasTaunt) ||
                                       (SelectedKeyword == "衝鋒" && c.HasCharge) ||
                                       (SelectedKeyword == "貫穿" && c.HasTrample) ||
                                       (SelectedKeyword == "劇毒" && c.HasPoison) ||
                                       (SelectedKeyword == "聖盾" && c.Text.Contains("聖盾")) ||
                                       (SelectedKeyword == "箭頭" && c.Arrows.Length>0) ||
                                       (SelectedKeyword == "反擊" && c.IsCounter) ||
                                       (SelectedKeyword == "沉默" && c.HasSilence));
            }

            if (!string.IsNullOrWhiteSpace(SearchText))
            {
                var q = SearchText.Trim();
                list = list.Where(c => c.Name.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                                       c.Text.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                                       c.Id.Contains(q, StringComparison.OrdinalIgnoreCase));
            }

            return list.OrderBy(c => c.IsEnergy ? 0 : 1)
                       .ThenBy(c => c.TotalCost)
                       .ThenBy(c => c.Id)
                       .ToList();
        }
    }
}
