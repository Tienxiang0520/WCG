@page "/ranked"
@using WcgWeb.Models.Ranked
@using WcgWeb.Models.Battle
@using WcgWeb.Components.Battle
@using WcgWeb.Components.Common
@using WcgWeb.Components.Ranked
@implements IAsyncDisposable
@inject RankedSession Ranked
@inject CardDatabase Cards
@inject DeckService Decks
@inject RankedDecks Opponents

<PageTitle>天梯 - 魂誓</PageTitle>
@if (ShowingBattle && Ranked.Error == "")
{
    <div class="phaser-page in-game ranked-game">
        @if (Ranked.BalanceNotice != "") { <p class="ranked-balance-notice" role="status">@Ranked.BalanceNotice</p> }
        <BattleBoard @key="Presenter" @ref="Board" Source="Ranked.Bridge" Driver="Ranked.Coordinator" Presenter="Presenter"
            InitialResponse="Initial" Ready="Ready" Changed="Changed" SessionAction="SessionAction" />
        @if (State?.IsOver == true && Profile.Result is { } result)
        {
            <section class="ranked-result @(result.Won ? "won" : "lost")" data-sfx-show="@ResultCues(result.Before, result.After)" role="status" aria-label="天梯結算">
                <p class="ranked-kicker">@result.Season 賽季</p><div class="ranked-result-emblem"><RankEmblem Tier="@RankedRules.Tier(result.After)" /></div><h2>@(result.Won ? "天梯勝利" : "本局敗北")</h2>
                <strong class="ranked-result-stars">@(result.After > result.Before ? "★ ＋1" : result.After < result.Before ? "★ －1" : "牌位保護 · 星數不變")</strong>
                <p>@RankedRules.Label(result.Before) → @RankedRules.Label(result.After)</p>
                @if (Profile.Match is { } finished && finished.Id == result.MatchId) { <p class="ranked-result-opponent">對手：@finished.ComputerDeck.Name</p> }
                @if (result.Season != Profile.Season) { <p>新賽季已開始，目前為 @RankedRules.Label(Profile.Stars)。</p> }
                <div class="ranked-result-actions"><button class="btn btn-primary" @onclick="Lobby">返回天梯</button>
                @if (Profile.Records?.Any(r => r.Id == result.MatchId) == true) { <button class="btn btn-outline-primary" data-sfx="nav" @onclick="() => ReviewFinished(result.MatchId)"><Icon Name="history" Size="17" />對局回顧</button> }</div>
            </section>
        }
    </div>
}
else
{
    <div class="ranked-lobby">
        <header class="page-hero">
            <div class="page-hero-text">
                <p class="eyebrow ranked-eyebrow"><Icon Name="trophy" Size="14" />單人天梯 · @Profile.Season 賽季</p>
                <h1>挑戰下一個牌位</h1>
                <p class="lead">每一場對局，往上多走一顆星。</p>
            </div>
            <div class="ranked-identity"><AvatarBadge Class="large" Caption="@($"{RankedRules.Label(Profile.Stars)} · 點擊換頭像")" /></div>
        </header>
        @if (Ranked.Error != "" || Notice != "") { <p class="alert alert-warning" role="alert">@(Ranked.Error != "" ? Ranked.Error : Notice)</p> }
        @if (Ranked.ResetNotice != "" && Ranked.Error == "") { <p class="alert alert-info" role="status">@Ranked.ResetNotice</p> }
        <div class="ranked-grid">
            <section class="ranked-card tier-@RankedRules.Tier(Profile.Stars)" aria-label="目前牌位">
                <div class="ranked-emblem-wrap"><RankEmblem Tier="@RankedRules.Tier(Profile.Stars)" /></div>
                <p class="ranked-kicker">目前牌位</p>
                <h2>@RankedRules.Label(Profile.Stars)</h2>
                @if (RankedRules.Tier(Profile.Stars) < 5)
                {
                    <div class="ranked-stars" role="img" aria-label="@(Profile.Stars % 5 + " / 5 星")">@for (var i = 0; i < 5; i++) { <Icon Name="star" Size="26" Class="@(i < Profile.Stars % 5 ? "pip on" : "pip")" /> }</div>
                    <p class="ranked-next">再 <b>@((5 - Profile.Stars % 5))</b> 勝晉升下一小段</p>
                }
                else { <p class="ranked-next">持續累積星數，刷新你的賽季紀錄。</p> }
                <dl class="ranked-stats">
                    <div><dt>本季戰績</dt><dd><span class="wcg-num">@Profile.Wins</span> 勝 · <span class="wcg-num">@Profile.Losses</span> 敗</dd></div>
                    <div><dt>勝率</dt><dd class="wcg-num">@(Profile.Wins + Profile.Losses == 0 ? "—" : $"{Profile.Wins * 100 / (Profile.Wins + Profile.Losses)}%")</dd></div>
                    <div><dt>歷史最高</dt><dd>@RankedRules.Label(Profile.BestStars)</dd></div>
                </dl>
            </section>
            <section class="ranked-entry wcg-panel">
                @if (Profile.Match is { Settled: false } ongoing)
                {
                    <h3 class="panel-title">有一場尚未完成的對局</h3><p class="ranked-matchup"><b>@ongoing.PlayerDeck.Name</b><span>VS</span><b>@ongoing.ComputerDeck.Name</b></p>
                    @if (ongoing.ComputerDeck.Description != "") { <p class="ranked-help">@ongoing.ComputerDeck.Description</p> }
                    <button class="btn btn-primary btn-lg" data-sfx="matchStart" disabled="@(!Interactive || Busy || Ranked.Error != "")" @onclick="Resume"><Icon Name="play" Size="18" />繼續對局</button>
                    <p class="ranked-help">離開頁面會保留進度。要放棄此局，請進入對戰設定選擇投降。</p>
                }
                else
                {
                    <h3 class="panel-title">出戰準備</h3>
                    @if (Profile.Result is { } last)
                    { <p class="ranked-last @(last.Won ? "won" : "lost")">上一場：@(last.Won ? "勝利 ＋1 星" : last.After == last.Before ? "敗北 · 牌位保護" : "敗北 －1 星")@(Profile.Match is { } previous && previous.Id == last.MatchId ? " · 對手 " + previous.ComputerDeck.Name : "")</p> }
                    <div class="wcg-field"><label for="ranked-deck">出戰牌組</label>
                    <select id="ranked-deck" class="form-select" @bind="SelectedDeck">
                        @foreach (var deck in Available) { <option value="@deck.Id" disabled="@(!deck.IsValid(Cards.GetCard, out _))">@deck.Name</option> }
                    </select></div>
                    <div class="ranked-intel">
                        <p class="ranked-intel-title"><span class="tier-tag">@RankedRules.Tiers[RankedRules.Tier(Profile.Stars)]</span>對手情報</p>
                        <p>@RankedDecks.Strategy(RankedRules.Tier(Profile.Stars))</p>
                        <p class="ranked-help">本牌位對手池：@Opponents.Summary(RankedRules.Tier(Profile.Stars))</p>
                    </div>
                    <button class="btn btn-primary btn-lg" data-sfx="matchFound" disabled="@(!Interactive || Busy || Ranked.Error != "")" @onclick="Start"><Icon Name="swords" Size="18" />開始天梯對戰</button>
                    <p class="ranked-help">先後手隨機；對手由同牌位牌組池抽選，不會連續遇到同一流派，每場另隨機微調 0～2 組卡牌。</p>
                }
            </section>
        </div>
        <section class="ranked-records wcg-panel" aria-labelledby="ranked-records-title">
            <header class="ranked-records-head">
                <h3 class="panel-title" id="ranked-records-title"><Icon Name="history" Size="18" />對戰紀錄</h3>
                <div class="segmented small-seg" role="radiogroup" aria-label="紀錄範圍">
                    <button type="button" role="radio" aria-checked="@(!AllSeasons ? "true" : "false")" class="@(!AllSeasons ? "on" : "")" @onclick="() => AllSeasons = false">本季</button>
                    <button type="button" role="radio" aria-checked="@(AllSeasons ? "true" : "false")" class="@(AllSeasons ? "on" : "")" @onclick="() => AllSeasons = true">全部</button>
                </div>
            </header>
            @if (Records.Count == 0)
            {
                <p class="ranked-records-empty">@(AllSeasons || (Profile.Records?.Count ?? 0) == 0 ? "完成一場天梯對局後，紀錄會出現在這裡，並可逐步回顧。" : "本季尚無對局紀錄，切換「全部」可查看先前賽季。")</p>
            }
            else
            {
                <ol class="ranked-records-list">
                    @foreach (var r in Records)
                    {
                        <li class="ranked-record @(r.Won ? "won" : "lost")">
                            <div class="record-result"><span class="record-badge">@(r.Won ? "勝" : "敗")</span><span class="record-stars">@StarChange(r)</span></div>
                            <div class="record-main">
                                <p class="record-matchup"><span class="will-chip @WillClass(r.ComputerDeck.MainWill)"><i class="will-dot"></i>@(r.ComputerDeck.MainWill == "" ? "混合" : r.ComputerDeck.MainWill)</span><b>@(r.Archetype != "" ? r.Archetype : r.ComputerDeck.Name)</b><small>使用 @r.PlayerDeck.Name</small></p>
                                <p class="record-meta"><span>@When(r)</span><span>@RankedRules.Label(r.Before) → @RankedRules.Label(r.After)</span><span class="wcg-num">@r.Turns 回合</span><span class="wcg-num">@Duration(r)</span>@if (AllSeasons) { <span>@r.Season 賽季</span> }</p>
                            </div>
                            <div class="record-actions">
                                <button type="button" class="btn btn-outline-primary record-deck-toggle" data-sfx="@(OpenDeck == r.Id ? "toggleOff" : "toggleOn")" aria-expanded="@(OpenDeck == r.Id ? "true" : "false")" aria-controls="deck-@r.Id" disabled="@(!Interactive)" @onclick="() => OpenDeck = OpenDeck == r.Id ? null : r.Id"><Icon Name="cards" Size="15" />對手牌組</button>
                                <button type="button" class="btn btn-outline-primary record-replay" data-sfx="nav" disabled="@(!Interactive)" aria-label="回顧 @When(r) 對戰 @r.ComputerDeck.Name" @onclick="() => OpenReplay(r)"><Icon Name="play" Size="15" />對局回顧</button>
                            </div>
                            @if (OpenDeck == r.Id)
                            {
                                var list = DeckList(r.ComputerDeck);
                                <div class="record-deck" id="deck-@r.Id" data-sfx-show="flip" data-sfx-delay="0">
                                    <p class="record-deck-title"><b>@r.ComputerDeck.Name</b><span class="wcg-num">@r.ComputerDeck.CardIds.Count 張</span>@if (r.ComputerDeck.Description != "") { <small>@r.ComputerDeck.Description</small> }</p>
                                    <ul class="record-deck-list">
                                        @foreach (var (card, count) in list)
                                        {
                                            <li><button type="button" class="deck-chip @WillClass(card.Will)" data-sfx="flip" title="查看 @card.Name" @onclick="() => Preview = GameEngine.VisibleCard(card, Guid.Empty)"><span class="deck-chip-cost wcg-num">@card.TotalCost</span><span class="deck-chip-name">@card.Name</span><span class="deck-chip-count wcg-num">×@count</span></button></li>
                                        }
                                    </ul>
                                    @if (list.Sum(x => x.Count) < r.ComputerDeck.CardIds.Count) { <p class="ranked-help">部分卡牌已不在目前的卡表中，未列出。</p> }
                                </div>
                            }
                        </li>
                    }
                </ol>
                <p class="ranked-help">保留最近 @RankedRules.MaxRecords 場；回顧依照當局隨機種子與行動重新模擬，只顯示你當時看得到的資訊。</p>
            }
        </section>
        <section class="ranked-info">
            <p class="ranked-season"><Icon Name="clock" Size="16" />本季至 @SeasonEnd（台灣時間）。新賽季下降兩個大牌位，最低青銅。</p>
            <details><summary>升段與存檔規則</summary><p>每小段 5 星，依 III → II → I 晉升。勝利加 1 星、敗北扣 1 星；青銅不扣星，同賽季不跌出已到達的大牌位。</p><p>進度自動保存在這台電腦。重新整理、關閉網站或重新啟動後可接續。跨月中的對局計入開局賽季，結束後套用降段。</p><p>牌位越高，電腦越聰明：青銅常出錯、亂選目標並看漏斬殺；白銀照基本順序出牌；黃金起會評估交換與目標並用直傷斬殺；白金注意反撲；鑽石與大師會規劃多步攻擊，大師幾乎不失誤。每個流派只在特定牌位出現：低牌位是入門流派的簡化牌表，高牌位排除較弱流派；嘲諷回血最強的白銀長城、誓約審判、荊棘毒牙只在大師出現，冰封堡壘從鑽石開始。電腦只看公開資訊，遵守相同卡牌規則。</p></details>
            @if (Profile.History.Count > 0)
            {
                <details><summary>歷季成績</summary><ul class="ranked-history">@foreach (var season in Profile.History.AsEnumerable().Reverse()) { <li><b>@season.Season</b><span>@RankedRules.Label(season.EndingStars)</span><span>最高 @RankedRules.Label(season.BestStars)</span><span class="wcg-num">@season.Wins 勝 @season.Losses 敗</span></li> }</ul></details>
            }
        </section>
    </div>
}
<CardPreviewDialog Card="Preview" OnClose="() => Preview = null" />
@if (Tour == "ranked" && !ShowingBattle)
{
    <WcgWeb.Components.Tutorial.GuidedTour LessonId="ranked" Checks="@(new Dictionary<string, bool> { ["ranked-all"] = AllSeasons })" />
}
@if (ReplayRecord != null)
{
    <RankedReplayViewer Record="ReplayRecord" Replay="Replay" OnClose="CloseReplay" />
}
@code {
    // Result stingers: tier change outranks a single star change (played after the battle victory/defeat stinger).
    private static string ResultCues(int before, int after) =>
        RankedRules.Tier(after) > RankedRules.Tier(before) ? "starGain rankUp" : RankedRules.Tier(after) < RankedRules.Tier(before) ? "starLoss rankDown" : after > before ? "starGain" : after < before ? "starLoss" : "";

    [SupplyParameterFromQuery(Name = "tour")] public string? Tour { get; set; }
    private RankedProfile Profile = new();
    private bool AllSeasons;
    private Guid? OpenDeck;
    private BattleCard? Preview;
    // The record keeps the exact computer deck used (including that match's random tweaks), so the list is what was played.
    private List<(CardDefinition Card, int Count)> DeckList(Deck deck) => deck.CardIds.GroupBy(id => id)
        .Select(g => (Card: Cards.GetCard(g.Key), Count: g.Count())).Where(x => x.Card != null).Select(x => (x.Card!, x.Count))
        .OrderBy(x => x.Item1.TotalCost).ThenBy(x => x.Item1.Id, StringComparer.Ordinal).ToList();
    private RankedRecord? ReplayRecord;
    private RankedReplay? Replay;
    private List<RankedRecord> Records => (Profile.Records ?? []).Where(r => AllSeasons || r.Season == Profile.Season).Reverse().ToList();
    // Taiwan has no daylight saving time, so a fixed UTC+8 matches Asia/Taipei on both server and WebAssembly.
    private static readonly TimeSpan Taipei = TimeSpan.FromHours(8);
    private static string When(RankedRecord r) => (r.EndedAt ?? r.StartedAt) is { } t ? t.ToOffset(Taipei).ToString("MM/dd HH:mm") : r.Season;
    private static string Duration(RankedRecord r)
    {
        if (r.StartedAt is not { } a || r.EndedAt is not { } b || b < a) return "—";
        var d = b - a; return d.TotalHours >= 1 ? $"{(int)d.TotalHours}時{d.Minutes:00}分" : $"{d.Minutes}分{d.Seconds:00}秒";
    }
    private static string StarChange(RankedRecord r) => r.After > r.Before ? "★＋1" : r.After < r.Before ? "★－1" : "保護";
    private static string WillClass(string will) => will switch
    { "狂怒" => "will-wrath", "理智" => "will-reason", "生機" => "will-vitality", "秩序" => "will-order", "深淵" => "will-abyss", _ => "will-neutral" };
    private async Task OpenReplay(RankedRecord r)
    {
        ReplayRecord = r; Replay = null; StateHasChanged();
        await Task.Delay(30); // let the loading state paint before the synchronous re-simulation
        if (ReplayRecord?.Id != r.Id) return;
        Replay = Ranked.BuildReplay(r.Id); StateHasChanged();
    }
    private void CloseReplay() { ReplayRecord = null; Replay = null; }
    private async Task ReviewFinished(Guid id)
    {
        await Lobby();
        if (Profile.Records?.LastOrDefault(r => r.Id == id) is { } r) await OpenReplay(r);
    }
    private List<Deck> Available = [];
    private string SelectedDeck = "", Notice = "";
    private bool Interactive, Busy, ShowingBattle, Disposed;
    private BattleSnapshot? State;
    private BattleBoard? Board;
    private BattleResponse? Initial;
    private Guid Presenter;
    private CancellationTokenSource? DriveCancellation;
    private Task? Driver;
    private readonly CancellationTokenSource Lifetime = new();
    private Task? RefreshLoop;
    private string SeasonEnd => DateTime.TryParse(Profile.Season + "-01", out var date) ? date.AddMonths(1).ToString("MM/dd 00:00") : "—";
    protected override void OnInitialized()
    {
        Profile = Ranked.Read(); Available = Decks.GetAllAvailableDecks();
        SelectedDeck = Available.Any(d => d.Id == Profile.SelectedDeck) ? Profile.SelectedDeck : Cards.PresetDecks[0].Id;
        Notice = Decks.LastStorageError ?? "";
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        Interactive = true;
        if (Profile.Match is { Settled: false } && Ranked.Error == "" && Tour != "ranked") await Resume();
        RefreshLoop = Refresh(); StateHasChanged();
    }
    private async Task Refresh()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(20));
            while (await timer.WaitForNextTickAsync(Lifetime.Token))
                await InvokeAsync(() => { if (!ShowingBattle) { Profile = Ranked.Read(); StateHasChanged(); } });
        }
        catch (OperationCanceledException) { }
    }
    private async Task StopDriver()
    {
        Ranked.Coordinator.Detach(Presenter); DriveCancellation?.Cancel();
        if (Driver != null) await Driver;
        Driver = null; DriveCancellation?.Dispose(); DriveCancellation = null;
    }
    private async Task Resume()
    {
        await StopDriver(); Profile = Ranked.Read();
        if (Ranked.Error != "" || Profile.Match == null) return;
        Presenter = Ranked.Coordinator.Attach(); Initial = Ranked.Coordinator.Resync(Presenter);
        State = Initial.State; ShowingBattle = true; StateHasChanged();
    }
    private async Task Start()
    {
        if (Busy) return; Busy = true;
        try
        {
            await StopDriver();
            var deck = Decks.GetDeck(SelectedDeck);
            if (deck == null) { Notice = "這副牌組已不存在，請重新選擇。"; return; }
            var response = Ranked.Start(deck); Notice = response.Message;
            if (response.Success) await Resume(); else ShowingBattle = false;
        }
        finally { Busy = false; Profile = Ranked.Read(); }
    }
    private Task Ready()
    {
        DriveCancellation = new();
        Driver = Ranked.Coordinator.DriveAsync(Presenter, response => InvokeAsync(async () =>
        { if (!Disposed && Board != null && ShowingBattle) await Board.Publish(response); }), DriveCancellation.Token);
        return Task.CompletedTask;
    }
    private Task Changed(BattleSnapshot state)
    { State = state; Profile = Ranked.Read(); StateHasChanged(); return Task.CompletedTask; }
    private async Task Lobby()
    { await StopDriver(); ShowingBattle = false; Board = null; Initial = null; Profile = Ranked.Read(); StateHasChanged(); }
    private async Task SessionAction(string type)
    {
        if (type == "reset") { await Lobby(); return; }
        if (type == "start") { await Start(); return; }
        if (type == "surrender")
        {
            var state = Ranked.Bridge.Snapshot();
            var response = Ranked.Coordinator.Submit(Presenter, new(Guid.NewGuid(), state.MatchId, state.Revision, "surrender"));
            if (Board != null) await Board.Publish(response);
        }
    }
    public async ValueTask DisposeAsync()
    {
        Disposed = true; Lifetime.Cancel(); await StopDriver();
        if (RefreshLoop != null) await RefreshLoop; Lifetime.Dispose();
    }
}
