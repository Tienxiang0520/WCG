@namespace LcgWeb.Components.Common
@inject IJSRuntime JS
@inject CardDatabase Cards
@inject RankedDecks Opponents
<section class="settings-panel" aria-labelledby="local-data-title">
    <h2 id="local-data-title">本機存檔</h2>
    <p>牌組、天梯進度與設定只存在這個瀏覽器。清除網站資料或更換裝置前，請先匯出備份。</p>
    <div class="d-flex flex-wrap gap-2">
        <button class="btn btn-outline-info" @onclick="Export">匯出存檔</button>
        <label class="btn btn-outline-light mb-0">選擇備份<InputFile OnChange="Stage" accept="application/json,.json" class="d-none" /></label>
    </div>
    @if (Pending != null)
    {
        <p class="mt-3">@Summary</p>
        <p>匯入會取代目前本機的牌組、天梯進度與設定。請先匯出目前存檔。</p>
        <button class="btn btn-warning" @onclick="Import">確認取代並匯入</button>
        <button class="btn btn-secondary ms-2" @onclick="() => Pending = null">取消</button>
    }
    <p class="mt-3" role="status">@Message</p>
</section>
@code {
    private string? Pending;
    private string Summary = "", Message = "";
    private async Task Export()
    {
        try { await JS.InvokeVoidAsync("soulOathStorage.exportBackup"); Message = "已匯出存檔。"; }
        catch (JSException) { Message = "存檔無法匯出，請確認瀏覽器允許下載。"; }
    }
    private async Task Stage(InputFileChangeEventArgs e)
    {
        Pending = null;
        Message = "正在檢查備份…";
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(5 * 1024 * 1024));
            var text = await reader.ReadToEndAsync();
            Summary = await JS.InvokeAsync<string>("soulOathStorage.inspectBackup", text);
            PlayerBackupValidator.Validate(text, Cards, Opponents);
            Pending = text; Message = "備份已讀取，請確認後匯入。";
        }
        catch (Exception ex) when (ex is IOException or InvalidDataException or JSException or System.Text.Json.JsonException or InvalidOperationException or ArgumentException) { Message = "未匯入：" + ex.Message; }
    }
    private async Task Import()
    {
        if (Pending == null) return;
        try { await JS.InvokeVoidAsync("soulOathStorage.importBackup", Pending); }
        catch (JSException ex) { Message = "未匯入，原存檔保留：" + ex.Message; }
    }
}
