@page "/battle-lab"
@page "/animation-lab"
@page "/spell-lab"
@page "/attack-lab"
@page "/shield-lab"
@using WcgWeb.Models.Battle
@using WcgWeb.Components.Battle
@using Microsoft.Extensions.Logging.Abstractions
@implements IAsyncDisposable
@inject CardDatabase Cards
@inject DeckService Decks
@inject NavigationManager Navigation

<PageTitle>@L[ShieldPrototype ? "聖盾疊加試玩" : AttackPrototype ? "攻擊操作試玩" : SpellPrototype ? "法術施放試玩" : Prototype ? "怪物出牌試玩" : "對戰操作實驗室"]</PageTitle>
<div class="@(Prototype ? "phaser-page in-game" : "phaser-page")">
    @if(Prototype)
    {
        <header class="battle-heading"><h1>@L[ShieldPrototype ? "聖盾疊加試玩" : AttackPrototype ? "攻擊操作試玩" : SpellPrototype ? "法術施放試玩" : "怪物出牌試玩"]</h1><a class="btn btn-outline-secondary" href="@(SpellPrototype ? "/animation-lab" : "/spell-lab")">@L[SpellPrototype ? "怪物出牌" : "法術施放"]</a><a class="btn btn-outline-secondary" href="/battle">@L["正式對戰"]</a></header>
        <div class="battle-toolbar"><strong>@L[AttackPrototype ? "拖曳場上怪物瞄準，放開後出擊；Esc 取消" : SpellPrototype ? "拖曳法術到施放區，再依提示選目標或效果" : "拖曳手牌到亮起的空位，或選牌後按召喚"]</strong>
            @if(ShieldPrototype){<select aria-label="@L["聖盾測試能量"]" @onchange="ChangeShieldEnergy"><option value="6">@L["6 點可用能量：巨像不帶盾"]</option><option value="7">@L["7 點可用能量：巨像可帶盾"]</option></select>}
            @if(AttackPrototype){<select aria-label="@L["攻擊測試場景"]" @onchange="ChangeAttackCase">
                <option value="survive">@L["擊倒目標並返回"]</option><option value="mutual">@L["同歸於盡"]</option><option value="shield">@L["打破聖盾"]</option><option value="face">@L["直接攻擊玩家"]</option>
            </select>}
            <button class="btn btn-primary" @onclick="Reset" disabled="@(!Loaded)">@L["重設測試場景"]</button></div>
    }
    else
    {
        <h1>@L["對戰操作實驗室"]</h1>
        <p>@L["固定測試場景，使用獨立引擎。可練習拖曳、嘲諷、法術目標、抉擇、牌庫檢視、附著狀態及取消；不會改變正式對局或牌組。這不是普通開局。"]</p>
        <button class="btn btn-primary" @onclick="Reset" disabled="@(!Loaded)">@L["重設測試場景"]</button>
        <a class="btn btn-outline-secondary" href="/battle">@L["真實對戰"]</a>
    }
    <BattleBoard @ref="Board" Presenter="Presenter" Source="Bridge" Driver="Coordinator" Ready="Ready" />
</div>
@code {
    private GameEngine Engine = null!;
    private BattleBridge Bridge = null!;
    private BattleCoordinator Coordinator = null!;
    private BattleBoard? Board;
    private Guid Presenter;
    private bool Loaded;
    private bool Prototype;
    private bool SpellPrototype;
    private bool AttackPrototype;
    private bool ShieldPrototype;
    private int ShieldEnergy = 6;
    private async Task ChangeShieldEnergy(ChangeEventArgs e){ShieldEnergy=int.Parse(e.Value!.ToString()!);await Reset();}
    private string AttackCase = "survive";
    private async Task ChangeAttackCase(ChangeEventArgs e){AttackCase=e.Value?.ToString()??"survive";await Reset();}
    protected override void OnInitialized()
    {
        var path = new Uri(Navigation.Uri).AbsolutePath;
        SpellPrototype = path == "/spell-lab";
        AttackPrototype = path == "/attack-lab";
        ShieldPrototype = path == "/shield-lab";
        Prototype = ShieldPrototype || AttackPrototype || SpellPrototype || path == "/animation-lab";
        Engine = new(Cards, new Random(17)); Bridge = new(Engine, Decks);
        Coordinator = new(Bridge, Engine, NullLogger<BattleCoordinator>.Instance); Presenter = Coordinator.Attach();
        Setup();
    }
    private Task Ready() { Loaded = true; StateHasChanged(); return Task.CompletedTask; }
    private void Setup()
    {
        Engine.StartGame(Cards.PresetDecks[0], Cards.PresetDecks[1]);
        Engine.Computer.IsAi = false; Engine.Player.Hand.Clear();
        if(ShieldPrototype)
        {
            foreach(var id in new[]{"WCG-079","WCG-062","WCG-074"}) Engine.Player.Hand.Add(new(Cards.GetCard(id)!));
            for(int i=0;i<ShieldEnergy;i++) Engine.Player.EnergyZone.Add(new(Cards.GetCard("WCG-101")!));
            var m=new MonsterInstance(Cards.GetCard("WCG-063")!){HasSummoningSickness=false,ShieldOwnerId=Engine.Player.Id};
            m.ShieldEnergies.Add(new(Cards.GetCard("WCG-101")!));Engine.Player.Field.Add(m);
            return;
        }
        if(AttackPrototype)
        {
            Engine.Player.Field.Add(new(Cards.GetCard(AttackCase=="mutual"?"WCG-101":"WCG-009")!){HasSummoningSickness=false});
            Engine.Player.Field.Add(new(Cards.GetCard("WCG-101")!){HasSummoningSickness=false});
            if(AttackCase!="face"){
                var target=new MonsterInstance(Cards.GetCard(AttackCase=="shield"?"WCG-063":"WCG-101")!){HasSummoningSickness=false};
                if(AttackCase=="shield"){target.ShieldEnergies.Add(new(Cards.GetCard("WCG-101")!));target.ShieldOwnerId=Engine.Computer.Id;}
                Engine.Computer.Field.Add(target);
                Engine.Computer.Field.Add(new(Cards.GetCard("WCG-101")!){HasSummoningSickness=false});
            }
            return;
        }
        if(SpellPrototype)
        {
            foreach(var id in new[]{"WCG-026","WCG-121","WCG-046","WCG-030","WCG-024","WCG-096"}) Engine.Player.Hand.Add(new(Cards.GetCard(id)!));
            for(int i=0;i<15;i++) Engine.Player.EnergyZone.Add(new(Cards.GetCard("WCG-101")!));
            Engine.Player.Field.Add(new(Cards.GetCard("WCG-101")!){HasSummoningSickness=false});
            foreach(var id in new[]{"WCG-003","WCG-063","WCG-101"}) Engine.Computer.Field.Add(new(Cards.GetCard(id)!){HasSummoningSickness=false});
            Engine.Player.Deck.InsertRange(0,new[]{"WCG-101","WCG-121","WCG-122"}.Select(id=>new CardInstance(Cards.GetCard(id)!)));
            return;
        }
        if(Prototype)
        {
            foreach(var id in new[]{"WCG-101","WCG-009","WCG-101"}) Engine.Player.Hand.Add(new(Cards.GetCard(id)!));
            for(int i=0;i<10;i++) Engine.Player.EnergyZone.Add(new(Cards.GetCard("WCG-101")!));
            Engine.Player.Field.Add(new(Cards.GetCard("WCG-101")!){HasSummoningSickness=false});
            return;
        }
        foreach (var id in new[]{"WCG-003","WCG-009","WCG-026","WCG-030","WCG-046","WCG-062","WCG-072","WCG-096"}) Engine.Player.Hand.Add(new(Cards.GetCard(id)!));
        for(int i=0;i<10;i++) Engine.Player.EnergyZone.Add(new(Cards.GetCard("WCG-101")!));
        foreach(var id in new[]{"WCG-003","WCG-009"}) Engine.Player.Field.Add(new(Cards.GetCard(id)!){HasSummoningSickness=false});
        foreach(var id in new[]{"WCG-063","WCG-003","WCG-101","WCG-081"}) Engine.Computer.Field.Add(new(Cards.GetCard(id)!){HasSummoningSickness=false});
        Engine.Player.Deck.InsertRange(0,new[]{"WCG-101","WCG-121","WCG-122"}.Select(id=>new CardInstance(Cards.GetCard(id)!)));
    }
    private async Task Reset()
    {
        Setup();
        if(Board!=null) await Board.Publish(Coordinator.Resync(Presenter));
    }
    public ValueTask DisposeAsync() { Coordinator.Detach(Presenter); Coordinator.Dispose(); return ValueTask.CompletedTask; }
}
