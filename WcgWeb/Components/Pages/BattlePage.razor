@page "/"
@page "/battle"
@using WcgWeb.Models.Battle
@using WcgWeb.Components.Battle
@implements IAsyncDisposable
@inject IConfiguration Configuration
@inject NavigationManager Navigation
@inject CardDatabase CardDb
@inject DeckService DeckSvc
@inject BattleBridge Bridge
@inject BattleCoordinator Coordinator

<PageTitle>對戰 - 魂誓</PageTitle>
<div class="@(State != null && State.Phase != "NotStarted" ? "phaser-page in-game" : "phaser-page")">
    @if (Notice != "") { <p class="alert alert-warning" role="status">@Notice</p> }
    @if (State?.Phase == "NotStarted")
    {
        <section class="battle-panel setup-panel">
            <h2>準備對局</h2>
            <label for="phaser-player">你的牌組</label><select id="phaser-player" class="form-select" @bind="PlayerDeck">
                @foreach (var deck in Decks) { <option value="@deck.Id" disabled="@(!deck.IsValid(CardDb.GetCard, out _))">@deck.Name</option> }
            </select>
            <label for="phaser-computer">電腦牌組</label><select id="phaser-computer" class="form-select" @bind="ComputerDeck">
                @foreach (var deck in Decks) { <option value="@deck.Id" disabled="@(!deck.IsValid(CardDb.GetCard, out _))">@deck.Name</option> }
            </select>
            <label for="phaser-starter">先攻</label><select id="phaser-starter" class="form-select" @bind="First"><option value="player">玩家先攻</option><option value="computer">電腦先攻</option><option value="random">隨機</option></select>
            <p>50 張牌組、7 點生命；起手 7 張。每回合可將一張手牌背面填為能量，不抽牌。</p>
            <button class="btn btn-primary btn-lg" disabled="@(Sending || !Interactive)" @onclick="Start">開始對戰</button>
        </section>
    }
    @if (State != null && State.Phase != "NotStarted")
    {
        <BattleBoard @ref="Board" Presenter="Presenter" InitialResponse="InitialResponse" Ready="OnReady" Changed="StateChanged" SessionAction="SessionAction" />
    }
</div>
@code {
    private List<Deck> Decks = [];
    private string PlayerDeck = "", ComputerDeck = "", First = "player", Notice = "";
    private Guid Presenter;
    private BattleSnapshot? State;
    private BattleBoard? Board;
    private bool Interactive, BattleReady, Sending, Disposed;
    private BattleResponse? InitialResponse;
    private readonly CancellationTokenSource Lifetime = new();
    private Task? Driver;
    protected override void OnInitialized()
    {
        if (Configuration["BattlePresentation:Mode"] == "legacy" && new Uri(Navigation.Uri).AbsolutePath == "/")
        { Navigation.NavigateTo("/legacy", replace: true); return; }
        Decks = DeckSvc.GetAllAvailableDecks(); Notice = DeckSvc.LastStorageError ?? "";
        PlayerDeck = CardDb.PresetDecks[0].Id; ComputerDeck = CardDb.PresetDecks[1].Id;
        Presenter = Coordinator.Attach(); State = Bridge.Snapshot();
    }
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) { Interactive = true; StateHasChanged(); }
    }
    private Task StateChanged(BattleSnapshot state) { State = state; StateHasChanged(); return Task.CompletedTask; }
    private Task OnReady()
    {
        if (Disposed || State?.Phase == "NotStarted") return Task.CompletedTask;
        BattleReady = true;
        Driver ??= Coordinator.DriveAsync(Presenter, response => InvokeAsync(async () =>
        { if (!Disposed && Board != null) await Board.Publish(response); }), Lifetime.Token);
        StateHasChanged(); return Task.CompletedTask;
    }
    private async Task Start() => await Command("start");
    private Task SessionAction(string type) => type switch
    {
        "surrender" when State?.IsOver == false => Command(type),
        "reset" => Command(type),
        "start" when State?.IsOver == true => Command(type),
        _ => Task.CompletedTask
    };
    private async Task Command(string type)
    {
        if (Sending || State == null || type is not ("start" or "reset") && !BattleReady) return;
        Sending = true;
        try
        {
            var current = Bridge.Snapshot();
            var response = Coordinator.Submit(Presenter, new(Guid.NewGuid(), current.MatchId, current.Revision, type,
                PlayerDeckId: PlayerDeck, ComputerDeckId: ComputerDeck,
                PlayerFirst: First == "player" || First == "random" && Random.Shared.Next(2) == 0));
            Notice = response.Message;
            if (response.Success && type == "reset")
            {
                // Leave the scene entirely; the next match receives a fresh board instance.
                State = response.State; InitialResponse = null; Board = null; BattleReady = false;
                Coordinator.Acknowledge(Presenter, response.State.MatchId, response.State.Revision, response.BatchId);
            }
            else if (response.Success && type == "start" && State.Phase == "NotStarted")
            {
                // Mount only after the start command succeeds. The child presents and acknowledges this batch.
                InitialResponse = response; State = response.State; BattleReady = false;
            }
            else if (Board != null) await Board.Publish(response);
        }
        finally { Sending = false; }
    }
    public async ValueTask DisposeAsync()
    {
        Disposed = true; Coordinator.Detach(Presenter); Lifetime.Cancel();
        if (Driver != null) await Driver; Lifetime.Dispose();
    }
}
