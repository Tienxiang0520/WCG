@using WcgWeb.Components.Common
@page "/settings"
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@L["設定 - 魂誓"]</PageTitle>
<section class="settings-page">
    <header class="page-hero compact">
        <div class="page-hero-text">
            <p class="eyebrow"><Icon Name="gear" Size="14" />@L["設定"]</p>
            <h1>@L["你的魂誓"]</h1>
            <p class="lead settings-note">@L["調整頭像與對戰操作習慣，選擇會儲存在這個瀏覽器。"]</p>
        </div>
    </header>
    <LanguageSettings />
    <section class="settings-panel" aria-labelledby="operation-settings">
        <h2 id="operation-settings">@L["操作"]</h2>
        <div class="setting-row">
            <div>
                <h3 id="energy-confirmation-label">@L["填能量前再次確認"]</h3>
                <p id="energy-confirmation-help">@L["開啟時，按下填能量或把手牌拖到能量區後，會先請你確認。關閉後會直接填入能量。"]</p>
            </div>
            <button type="button" class="setting-switch" role="switch" aria-checked="@(ConfirmEnergy ? "true" : "false")"
                    aria-labelledby="energy-confirmation-label" aria-describedby="energy-confirmation-help"
                    disabled="@(!Loaded || Saving)" @onclick="ToggleEnergyConfirmation">
                <span class="switch-track" aria-hidden="true"><span></span></span>
                <span>@L[ConfirmEnergy ? "開啟" : "關閉"]</span>
            </button>
        </div>
        <div class="setting-row">
            <div>
                <h3 id="stat-breakdown-label">@L["顯示原始數值與加成"]</h3>
                <p id="stat-breakdown-help">@L["開啟時，場上怪物顯示印刷數值與增減（例如 1000 +300）。關閉時只顯示目前數值，高於印刷值為綠色、低於為紅色。點開卡片一律會列出每個加成的來源。"]</p>
            </div>
            <button type="button" class="setting-switch" role="switch" aria-checked="@(ShowBreakdown ? "true" : "false")"
                    aria-labelledby="stat-breakdown-label" aria-describedby="stat-breakdown-help"
                    disabled="@(!Loaded || Saving)" @onclick="ToggleStatBreakdown">
                <span class="switch-track" aria-hidden="true"><span></span></span>
                <span>@L[ShowBreakdown ? "開啟" : "關閉"]</span>
            </button>
        </div>
    </section>
    <AudioSettings />
    <section class="settings-panel" aria-labelledby="avatar-settings">
        <h2 id="avatar-settings">@L["玩家頭像"]</h2>
        <AvatarPicker />
    </section>
    <p class="settings-status" role="status">@L[Status]</p>
    @if (Tour == "settings") { <WcgWeb.Components.Tutorial.GuidedTour LessonId="settings" /> }
</section>

@code {
    [SupplyParameterFromQuery(Name = "tour")] public string? Tour { get; set; }
    private IJSObjectReference? Module;
    private bool ConfirmEnergy = true, ShowBreakdown, Loaded, Saving;
    private string Status = "載入設定…";
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            Module = await JS.InvokeAsync<IJSObjectReference>("import", "./battle/preferences.js");
            ConfirmEnergy = await Module.InvokeAsync<bool>("readEnergyConfirmation");
            ShowBreakdown = await Module.InvokeAsync<bool>("readStatBreakdown");
            Loaded = true; Status = "設定會自動儲存。";
        }
        catch (JSException) { Status = "設定載入失敗，請重新整理再試。"; }
        StateHasChanged();
    }
    private async Task ToggleEnergyConfirmation()
    {
        if (!Loaded || Saving || Module == null) return;
        Saving = true;
        try
        {
            var next = !ConfirmEnergy;
            await Module.InvokeVoidAsync("saveEnergyConfirmation", next);
            ConfirmEnergy = next; Status = "已儲存。";
        }
        catch (JSException) { Status = "無法儲存設定，已保留原本的選擇。"; }
        finally { Saving = false; }
    }
    private async Task ToggleStatBreakdown()
    {
        if (!Loaded || Saving || Module == null) return;
        Saving = true;
        try
        {
            var next = !ShowBreakdown;
            await Module.InvokeVoidAsync("saveStatBreakdown", next);
            ShowBreakdown = next; Status = "已儲存。";
        }
        catch (JSException) { Status = "無法儲存設定，已保留原本的選擇。"; }
        finally { Saving = false; }
    }
    public async ValueTask DisposeAsync()
    {
        if (Module == null) return;
        try { await Module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
