@namespace WcgWeb.Components.Common
@* Self-drawn line icons (24×24, currentColor). Decorative unless a Label is given. *@
<svg class="wcg-icon @Class" viewBox="0 0 24 24" width="@Size" height="@Size" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="@(Label == null ? "true" : null)" role="@(Label == null ? null : "img")" aria-label="@Label" focusable="false">
    @switch (Name)
    {
        case "swords":
            <path d="M14.5 17.5 3 6V3h3l11.5 11.5" /><path d="m13 19 6-6M16 16l4 4M19 21l2-2" /><path d="M9.5 6.5 14 2h3v3l-4.5 4.5" /><path d="m5 14 4 4M7 17l-3 3M3 19l2 2" />
            break;
        case "trophy":
            <path d="M8 4h8v5a4 4 0 0 1-8 0V4Z" /><path d="M16 5h3v2a3 3 0 0 1-3 3M8 5H5v2a3 3 0 0 0 3 3" /><path d="M12 13v4M8.5 20h7M9.5 17h5l.5 3h-6l.5-3Z" />
            break;
        case "cards":
            <rect x="7.5" y="3.5" width="11" height="15" rx="1.8" transform="rotate(8 13 11)" /><path d="M5.6 6.2 4 7a1.8 1.8 0 0 0-.8 2.3l4.2 9.6a1.8 1.8 0 0 0 2.3.9l1.1-.5" /><path d="m12.6 9.2 1.6 2.7-2.4 1.6" />
            break;
        case "book":
            <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5v-15Z" /><path d="M4 20.5A2.5 2.5 0 0 1 6.5 18H20v3H6.5" /><path d="M12 7v6M9 10h6" />
            break;
        case "scroll":
            <path d="M7 4h11a2 2 0 0 1 2 2v1h-4" /><path d="M16 7v11a2.5 2.5 0 0 1-5 0v-1H4v1a2.5 2.5 0 0 0 2.5 2.5H13" /><path d="M7 4a2 2 0 0 0-2 2v11" /><path d="M9 9h4M9 12.5h4" />
            break;
        case "gear":
            <circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z" />
            break;
        case "menu":
            <path d="M4 7h16M4 12h16M4 17h10" />
            break;
        case "close":
            <path d="M6 6l12 12M18 6 6 18" />
            break;
        case "chevron-left":
            <path d="m15 5-7 7 7 7" />
            break;
        case "chevron-right":
            <path d="m9 5 7 7-7 7" />
            break;
        case "search":
            <circle cx="11" cy="11" r="6.5" /><path d="m20 20-4.4-4.4" />
            break;
        case "star":
            <path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3Z" />
            break;
        case "shield":
            <path d="M12 3 19 6v5.5c0 4.4-3 8-7 9.5-4-1.5-7-5.1-7-9.5V6l7-3Z" /><path d="m9 12 2 2 4-4" />
            break;
        case "flame":
            <path d="M12 21c-3.9 0-6.5-2.6-6.5-6.2 0-3.6 3.1-5.7 3.6-9.8 2.6 1.5 4.2 3.7 4.5 6.1 1-.6 1.6-1.7 1.7-2.9 1.9 1.6 3.2 4 3.2 6.6 0 3.6-2.6 6.2-6.5 6.2Z" /><path d="M12 21c-1.7 0-2.8-1.2-2.8-2.8 0-1.9 1.6-2.7 2.1-4.5 1.9 1.1 3.5 2.6 3.5 4.5 0 1.6-1.1 2.8-2.8 2.8Z" />
            break;
        case "sigil":
            <path d="M12 2.5 20.5 7v10L12 21.5 3.5 17V7L12 2.5Z" /><path d="M12 6.5 16.8 9.2v5.6L12 17.5l-4.8-2.7V9.2L12 6.5Z" /><path d="M12 6.5v11M7.2 9.2l9.6 5.6M16.8 9.2l-9.6 5.6" />
            break;
        case "play":
            <path d="M7 4.5v15l12-7.5-12-7.5Z" />
            break;
        case "pause":
            <path d="M8 5v14M16 5v14" />
            break;
        case "skip-back":
            <path d="M18 5.5v13L9 12l9-6.5ZM6 5v14" />
            break;
        case "skip-forward":
            <path d="M6 5.5v13L15 12 6 5.5ZM18 5v14" />
            break;
        case "heart":
            <path d="M12 20s-7.5-4.6-7.5-10A4.3 4.3 0 0 1 12 7.4 4.3 4.3 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10Z" />
            break;
        case "bolt":
            <path d="M13 2.5 4.5 13.5H11L10 21.5l8.5-11H12l1-8Z" />
            break;
        case "history":
            <path d="M3.5 12a8.5 8.5 0 1 0 2.5-6" /><path d="M3 4v4.5h4.5" /><path d="M12 7.5V12l3 2" />
            break;
        case "lock":
            <rect x="5" y="10.5" width="14" height="10" rx="2" /><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3" />
            break;
        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;
        case "minus":
            <path d="M5 12h14" />
            break;
        case "eye":
            <path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z" /><circle cx="12" cy="12" r="3" />
            break;
        case "save":
            <path d="M5 3.5h11l3.5 3.5v12a1.5 1.5 0 0 1-1.5 1.5H5A1.5 1.5 0 0 1 3.5 19V5A1.5 1.5 0 0 1 5 3.5Z" /><path d="M7.5 3.5V8h7V3.5M7.5 20.5v-6h9v6" />
            break;
        case "trash":
            <path d="M4 7h16M10 11v6M14 11v6M5.5 7l1 12.5A1.5 1.5 0 0 0 8 21h8a1.5 1.5 0 0 0 1.5-1.5l1-12.5M9 7V4.5A1.5 1.5 0 0 1 10.5 3h3A1.5 1.5 0 0 1 15 4.5V7" />
            break;
        case "folder":
            <path d="M3.5 6.5A1.5 1.5 0 0 1 5 5h4.5l2 2.5H19a1.5 1.5 0 0 1 1.5 1.5v9A1.5 1.5 0 0 1 19 19.5H5A1.5 1.5 0 0 1 3.5 18V6.5Z" />
            break;
        case "printer":
            <path d="M7 8V3.5h10V8M7 17H5a1.5 1.5 0 0 1-1.5-1.5v-6A1.5 1.5 0 0 1 5 8h14a1.5 1.5 0 0 1 1.5 1.5v6A1.5 1.5 0 0 1 19 17h-2" /><path d="M7 13.5h10v7H7z" />
            break;
        case "spark":
            <path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M18 6l-2.5 2.5M8.5 15.5 6 18" />
            break;
        case "clock":
            <circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" />
            break;
        case "user":
            <circle cx="12" cy="8.5" r="4" /><path d="M4.5 20.5c1.2-3.6 4-5.5 7.5-5.5s6.3 1.9 7.5 5.5" />
            break;
        case "upload":
            <path d="M12 16V4M7 9l5-5 5 5M4.5 15v3.5A1.5 1.5 0 0 0 6 20h12a1.5 1.5 0 0 0 1.5-1.5V15" />
            break;
        case "download":
            <path d="M12 4v12M7 11l5 5 5-5M4.5 15v3.5A1.5 1.5 0 0 0 6 20h12a1.5 1.5 0 0 0 1.5-1.5V15" />
            break;
        case "sound":
            <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4v-5Z" /><path d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11" />
            break;
        case "mute":
            <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4v-5Z" /><path d="m16 9.5 5 5M21 9.5l-5 5" />
            break;
        case "motion-off":
            <circle cx="12" cy="12" r="7.5" stroke-dasharray="3 3" />
            break;
        case "flag":
            <path d="M5 21V4M5 4.5h11l-2 4 2 4H5" />
            break;
        case "tools":
            <path d="M14.5 6.5a4 4 0 0 0 5 5L12 19a2.1 2.1 0 0 1-3-3l7.5-7.5Z" /><path d="M4 4l5 5M3.5 7 7 3.5" />
            break;
        default:
            <circle cx="12" cy="12" r="8" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public int Size { get; set; } = 20;
    [Parameter] public string? Label { get; set; }
}
