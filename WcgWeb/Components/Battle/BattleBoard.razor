@namespace WcgWeb.Components.Battle
@using WcgWeb.Models.Battle
@using WcgWeb.Components.Common
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject BattleBridge Bridge
@inject BattleCoordinator Coordinator
@inject PlayerProfileStore Profile
@if(State is {} s)
{
<section class="v06-board @(Training?"training":"") @(Dragging!=null?"dragging":"") @(s.ActivePlayerId=="player"?"turn-player":"turn-computer") @(MotionReduced?"motion-reduced":"")" aria-label="@L["v0.6 卡牌戰場"]" @ref="BoardElement">
    <div class="board-ambience" aria-hidden="true"></div>
    <header class="match-header"><strong class="turn-chip @(s.ActivePlayerId=="player"?"mine":"theirs")" @key="s.Turn">@L.F("第 {0} 回合", s.Turn) · @L[s.ActivePlayerId=="player"?"你的回合":"電腦回合"]</strong><span>v0.6</span>@if(Training){<button class="training-toggle" aria-label="@L["測試工具"]" title="@L["測試工具"]" disabled="@(Busy||Presenting||EnergyCandidate!=null||Detail!=null||ShowHistory)" @onclick="()=>OpenTraining.InvokeAsync()"><Icon Name="tools" Size="15" /><span class="header-label">@L["測試工具"]</span></button>}<button class="motion-toggle" aria-pressed="@(MotionReduced?"true":"false")" aria-label="@L[MotionReduced?"切換為完整特效":"切換為精簡特效"]" title="@L[MotionReduced?"特效：精簡（點擊改為完整）":"特效：完整（點擊改為精簡）"]" @onclick="ToggleMotion"><Icon Name="@(MotionReduced?"motion-off":"spark")" Size="16" /><span class="motion-label"> @L[MotionReduced?"精簡":"特效"]</span></button><button class="sound-toggle" data-sound-toggle aria-label="@L[SoundEnabled?"靜音":"開啟音效"]" title="@L[SoundEnabled?"靜音":"開啟音效"]" @onclick="ToggleSound"><Icon Name="@(SoundEnabled?"sound":"mute")" Size="17" /></button><button @onclick='()=>SessionAction.InvokeAsync("surrender")' disabled="@(s.IsOver||Busy||Presenting)">@L["投降"]</button><button disabled="@(Busy||Presenting)" @onclick='()=>SessionAction.InvokeAsync("reset")'>@L["返回房間"]</button></header>
    <div class="opponent hero @HeroClass(s,s.Computer,false) @(LegalZone("face")?"legal":"") @(FaceBlocked?"face-blocked":"")" data-drop-zone="face" aria-label="@L.F("電腦頭像 · 生命 {0} / 7", s.Computer.Hp)">@HeroFace(s.Computer,false)<div class="hero-meta"><strong>@L["電腦"]</strong><small>@L.F("能量 {0} / {1} · 手牌 {2}", s.Computer.AvailableEnergy, s.Computer.TotalEnergy, s.Computer.HandCount)</small><small class="hero-deck">@L.F("牌庫 {0}", s.Computer.DeckCount)</small></div>@if(FaceBlocked){<span class="hero-blocked">@L[s.Computer.Field.Any(m=>m.Status.Contains("嘲諷"))?"🛡 嘲諷阻擋":"無法直接攻擊"]</span>}</div>
    <p class="battle-message" role="status">@L.Text(Message) @L.Text(s.IsOver?s.Outcome:(Busy||Presenting)?"動作進行中":s.Pending?.Title ?? (TrainingToolsOpen?"訓練工具已開啟":Training&&TrainingAiPaused&&s.DecisionPlayerId=="computer"?"電腦已暫停 · 開啟測試工具選擇單步或自動行動":!CanAct?"等待電腦行動或效果選擇":""))@if(ShowActHint){<span class="hint-mouse">@L["拖曳出牌或攻擊 · 左鍵看牌 · 右鍵切換蓋牌"]</span><span class="hint-touch">@L["拖曳出牌或攻擊 · 點牌放大／切換蓋牌"]</span>}</p>
    <div class="battlefield @(LegalZone("center")?"legal":"")" data-drop-zone="center">
    @foreach(var side in new[]{s.Computer,s.Player})
    {
        var mine=side.Id=="player";
        <div class="v06-row" aria-label="@L[mine?"己方五格":"敵方五格"]">
        @for(int screen=0;screen<5;screen++)
        {
            var slot=mine?screen:4-screen;var m=side.Field.FirstOrDefault(x=>x.Slot==slot);
            <article class="v06-slot @(m?.Tapped==true?"tapped":"") @(m==null?"vacant":"") @(LegalSlot(mine,slot,m)?"legal":"")" data-drop-zone="@(mine?"own":"enemy")" data-slot="@slot" data-target="@m?.Card.InstanceId" @onclick="()=>OpenSlot(m)">
                @if(m==null){<small class="slot-number">@L[mine?"己方":"敵方"] @(slot+1)</small>}
                @if(m==null){<div class="empty">＋</div>}
                else
                {
                    <div class="field-card @(mine?"":"enemy-card") @(m.Status.Contains("嘲諷")?"has-taunt":"") @(m.Status.Any(x=>x.StartsWith("聖盾"))?"has-shield":"") @(m.Status.Contains("沉默")?"is-silenced":"") @(m.Status.Contains("劇毒")?"is-poisonous":"") @(mine&&CanDrag&&(m.CanAttack||m.CanActivate)?"action-ready":"") @(mine&&m.CanAttack&&CanDrag?"attack-ready":"")" aria-label="@L.CardName(m.Card)" data-drag-kind="@(mine&&m.CanAttack&&CanDrag?"attack":null)" data-drag-id="@m.Card.InstanceId">
                    @if(m.IsSet){<div class="field-card-back" aria-hidden="true">@L["魂"]<br/>@L["誓"]</div>}
                    else{<div class="card-art-layer" aria-hidden="true"><CardImage CardId="@m.Card.CardId" Loading="eager" /></div>}
                    @if(m.Status.Contains("嘲諷")){<img class="taunt-frame" src="battle/taunt-frame.svg" alt="" aria-hidden="true" draggable="false" />}
                    @foreach(var arrow in m.Card.Arrows ?? []){<span class="arrowmark @arrow">@(arrow=="left"?"←":arrow=="right"?"→":"↑")</span>}
                    <strong>@L.CardName(m.Card)</strong>
                    @if(m.Card.PP!=null){<div class="field-stats"><b>@m.PP</b><b>@m.DP</b></div>}
                    </div>
                }
            </article>
        }
        </div>
    }
    </div>
    <div class="player hero @HeroClass(s,s.Player,true)" role="button" tabindex="0" title="@L["點擊更換頭像"]" aria-label="@L.F("你的頭像 · 生命 {0} / 7 · 點擊更換頭像", s.Player.Hp)" @onclick="()=>AvatarOpen=true" @onkeydown='e=>{if(e.Key=="Enter"||e.Key==" ")AvatarOpen=true;}'>@HeroFace(s.Player,true)<div class="hero-meta"><strong>@L["你"]</strong><small>@L.F("牌庫 {0}", s.Player.DeckCount)</small></div></div>
    <aside class="energy-zone @(LegalZone("energy")?"legal":"")" data-drop-zone="energy"><strong>@L["能量"] <span class="energy-count" @key="s.Player.AvailableEnergy">@s.Player.AvailableEnergy</span> / @s.Player.TotalEnergy</strong><span>@L["拖手牌到這裡填能量"]</span><div class="energy-dots">@foreach(var energy in s.Player.Energy){<i @key="energy.InstanceId" class="@(energy.Tapped?"spent":"")"></i>}</div></aside>
    <aside class="turn-controls"><button class="end-turn @(NoMovesLeft?"no-moves":"")" title="@(NoMovesLeft?L["沒有可用的行動了"]:"")" disabled="@(!CanAct || s.Pending!=null || EnergyCandidate!=null)" @onclick='()=>Send("end")'>@L["結束回合"]</button><button @onclick="()=>ShowHistory=true">@L["紀錄／墓地"]</button></aside>
    <div class="v06-hand" aria-label="@L["扇形手牌"]">
    @for(var i=0;i<s.Hand.Length;i++)
    {
        var h=s.Hand[i];var index=i;var faceDown=SetModes.Contains(h.Card.InstanceId);
        <article @key="h.Card.InstanceId" class="v06-hand-card @(faceDown?"card-back":"") @(HandClass(h,faceDown))" title="@L[HandHint(h,faceDown)]" style="@FanStyle(index,s.Hand.Length)" data-drag-kind="@(CanDrag?"hand":null)" data-card-type="@h.Card.Type" data-card-cost="@h.Card.Cost" data-drag-id="@h.Card.InstanceId" @onclick="()=>OpenCard(h.Card)" @oncontextmenu="()=>ToggleSet(h.Card.InstanceId)" @oncontextmenu:preventDefault="true" tabindex="0" role="button" aria-label="@(L.CardName(h.Card)+L[faceDown?"，蓋牌模式":"，左鍵看牌，右鍵蓋牌"])" @onkeydown="e=>HandKey(e,h.Card)">
        @if(faceDown){<div class="back-emblem">@L["魂"]<br/>@L["誓"]</div><strong>@L["蓋牌模式"]</strong><small>@L["拖到己方空格 · 0 費"]</small><small>@L["右鍵翻回正面"]</small>}
        else{<div class="hand-art-layer" aria-hidden="true"><CardImage CardId="@h.Card.CardId" Loading="eager" /></div>@foreach(var arrow in h.Card.Arrows ?? []){<span class="arrowmark @arrow" title="@L[arrow=="left"?"指向左鄰格":arrow=="right"?"指向右鄰格":"指向正對面敵格"]">@(arrow=="left"?"←":arrow=="right"?"→":"↑")</span>}<span class="mana">@h.Card.Cost</span><strong>@L.CardName(h.Card)</strong><small>@L.CardType(h.Card.Type) · @L.Will(h.Card.Will)</small><p>@L.CardText(h.Card)</p>@if(h.Card.PP!=null){<b class="stats">@h.Card.PP PP · @h.Card.DP DP</b>}@if(h.Card.Arrows?.Length>0){<small>@L["箭頭"] @string.Join(" ",h.Card.Arrows.Select(a=>a=="left"?"←":a=="right"?"→":"↑"))</small>}}
        <span class="hand-availability">@L[HandLabel(h,faceDown)]</span><span class="hand-shine" aria-hidden="true"></span>
        </article>
    }
    </div>
    <small class="hand-hint"><span class="hint-mouse">@L["右鍵手牌切換蓋牌"]</span><span class="hint-touch">@L["點手牌放大可切換蓋牌"]</span> @L["· 背面牌拖入己方空格才進場"]</small>
    @if(!Busy&&!Presenting&&s.Pending is {} pending && pending.Kind!="target")
    {
        <div class="modal-shade"><section class="v06-dialog" role="dialog" aria-label="@L["效果選擇"]"><h3>@L.Text(pending.Title)</h3><p>@L.Text(pending.Description)</p><div class="choice-list">@foreach(var o in pending.Options){<button @onclick='()=>Send("choice",option:o.Id)'>@(o.Card!=null&&o.Title==o.Card.Name?L.CardName(o.Card):L.Text(o.Title)) <small>@L.Text(o.Subtitle)</small></button>}</div>@if(pending.CanCancel){<button @onclick='()=>Send("cancel")'>@L["取消（尚未付款）"]</button>}</section></div>
    }
    @if(!Busy&&!Presenting&&s.Pending is {Kind:"target"} targetPending){<div class="target-banner">@L.F("{0}：點選亮起的卡片選擇目標", targetPending.Title) @if(targetPending.CanCancel){<button @onclick='()=>Send("cancel")'>@L["取消"]</button>}</div>}
    @if(EnergyCandidate is {} energyId){<div class="modal-shade"><section class="v06-dialog" role="dialog" aria-label="@L["填能量確認"]"><h3>@L["填能量"]</h3><p>@L.F("將「{0}」轉為能量？不抽牌。", L.CardName(s.Hand.FirstOrDefault(h=>h.Card.InstanceId==energyId)?.Card))</p><button @onclick='()=>Send("energy",energyId,force:true)'>@L["確認填能量"]</button><button @onclick="CancelEnergy">@L["取消"]</button></section></div>}
    @if(ShowHistory){<div class="modal-shade" @onclick="()=>ShowHistory=false"><section class="v06-dialog history-dialog" role="dialog" aria-label="@L["對戰紀錄與墓地"]" @onclick:stopPropagation="true"><button class="close-dialog" @onclick="()=>ShowHistory=false">@L["關閉"]</button><h3>@L["雙方墓地"]</h3>@foreach(var side in new[]{s.Player,s.Computer}){<div class="grave-row"><span class="grave-side">@L[side.Id=="player"?"我方":"敵方"]</span>@if(side.Graveyard.Length==0){<span class="grave-empty">@L["（無）"]</span>}else{@foreach(var c in side.Graveyard){<button type="button" class="log-card" data-sfx="flip" title="@L.F("查看 {0}", L.CardName(c))" @onclick="()=>Detail=c">@L.CardName(c)</button>}}</div>}<h3>@L["對戰紀錄"]</h3><small class="history-hint">@L["點卡名可查看卡片。"]</small>@foreach(var line in History.Take(60)){<p class="log-line"><span>@L[line.Side] @L.Text(line.Label)</span>@if(line.Card is {} lc){<button type="button" class="log-card" data-sfx="flip" title="@L.F("查看 {0}", L.CardName(lc))" @onclick="()=>Detail=lc">@L.CardName(lc)</button>}</p>}</section></div>}
    @if(AvatarOpen){<div class="modal-shade" @onclick="()=>AvatarOpen=false"><section class="v06-dialog avatar-dialog" role="dialog" aria-label="@L["選擇頭像"]" @onclick:stopPropagation="true"><button class="close-dialog" @onclick="()=>AvatarOpen=false">@L["完成"]</button><h3>@L["選擇頭像"]</h3><AvatarPicker /></section></div>}
    @if(Detail is {} card){<div class="modal-shade" @onclick="()=>Detail=null"><section class="v06-dialog card-detail" role="dialog" aria-label="@L["卡片詳情"]" @onclick:stopPropagation="true"><button class="close-dialog" @onclick="()=>Detail=null">@L["關閉"]</button><h2 class="visually-hidden">@L.CardName(card)</h2><CardFace Battle="card" Class="face-preview detail-face" Loading="eager" />@if(s.Player.Field.Concat(s.Computer.Field).FirstOrDefault(m=>m.Card.InstanceId==card.InstanceId) is {} own){@if(own.Card.PP!=null){<p>@L.F("目前數值：{0}", $"{own.PP} PP · {own.DP} DP")</p>}<p>@string.Join(" · ",own.Status.Select(L.Text))</p>@foreach(var a in own.Attachments??[]){<p class="attachment">@L.CardName(a)@L["："]@L.CardText(a)</p>}@if(own.Attachment!=null){<p class="attachment">@L["沉默"]@L["："]@L.CardName(own.Attachment) · @L.CardText(own.Attachment)</p>}@if(own.CanActivate){<button @onclick='()=>ActivateDetail(card.InstanceId)'>@L["發動結界"]</button>}}@if(CanAct&&s.Pending==null&&EnergyCandidate==null&&s.Hand.Any(h=>h.Card.InstanceId==card.InstanceId)){<button class="detail-set-toggle" @onclick="()=>ToggleSetFromDetail(card.InstanceId)">@L[SetModes.Contains(card.InstanceId)?"翻回正面":"切換為蓋牌"]</button>}<small>@L["關閉後拖曳卡片進行操作。"]</small></section></div>}
</section>
}
@code {
    // Animation banners only: the engine events themselves stay canonical (zh labels, card ids).
    private WcgWeb.Models.Battle.BattleEvent[] LocalizeEvents(WcgWeb.Models.Battle.BattleEvent[] events)=>!L.IsEnglish?events:events.Select(e=>e with{Label=L.Text(e.Label),Card=e.Card is {} c?c with{Name=L.CardName(c),Text=L.CardText(c)}:null}).ToArray();
    [Parameter] public BattleBridge? Source {get;set;}
    [Parameter] public BattleCoordinator? Driver {get;set;}
    private BattleBridge EffectiveBridge=>Source??Bridge;
    private BattleCoordinator EffectiveCoordinator=>Driver??Coordinator;
    [Parameter] public bool AnimationPrototype {get;set;}
    [Parameter] public BattleResponse? InitialResponse {get;set;}
    [Parameter] public Guid Presenter {get;set;}
    [Parameter] public EventCallback Ready {get;set;}
    [Parameter] public EventCallback<BattleSnapshot> Changed {get;set;}
    [Parameter] public EventCallback<string> SessionAction {get;set;}
    [Parameter] public bool Training {get;set;}
    [Parameter] public bool TrainingToolsOpen {get;set;}
    [Parameter] public bool TrainingAiPaused {get;set;}
    [Parameter] public EventCallback OpenTraining {get;set;}
    private BattleSnapshot? State;
    private bool Busy,Presenting,Disposed,ShowHistory,AvatarOpen;
    private Guid? EnergyCandidate,Dragging;
    private string DragKind="";
    private HashSet<Guid> SetModes=[];
    private BattleCard? Detail;
    private bool ConfirmEnergy=true,SoundEnabled=true,MotionReduced;
    private ElementReference BoardElement;
    private IJSObjectReference? Preferences,DragModule,DragBinding;
    private DotNetObjectReference<BattleBoard>? Self;
    private string Message="";
    private sealed record HistoryEntry(string Side,string Label,BattleCard? Card);
    private List<HistoryEntry> History=[];
    private bool CanAct=>!Busy&&!Presenting&&!TrainingToolsOpen&&State is {IsOver:false,DecisionPlayerId:"player"};
    // Presentation hint only: glow the end-turn button when nothing playable, fillable or attack-ready remains.
    private bool NoMovesLeft=>CanAct&&State is {Pending:null} s&&EnergyCandidate==null&&!s.Hand.Any(h=>h.CanPlay||h.CanEnergy)&&!s.Player.Field.Any(m=>m.CanAttack||m.CanActivate);
    private bool ShowActHint=>CanAct&&State?.Pending==null;
    // Hero portraits (presentation only): will tint from visible cards, damage stages, end-of-match states.
    private bool FaceBlocked=>Dragging!=null&&DragKind=="attack"&&!AttackTargets.Contains("face");
    private static string HeroClass(BattleSnapshot s,BattleSide side,bool mine)
    {
        var lost=s.IsOver&&(mine==s.Outcome.StartsWith("本局敗北"));
        var will=DominantWill(s,side,mine);
        return string.Join(' ',new[]{side.Hp<=2?"low-hp":side.Hp<=4?"hurt":"",s.ActivePlayerId==side.Id&&!s.IsOver?"is-active":"",will==null?"":$"will-{will}",s.IsOver?(lost?"defeated":"victorious"):""}.Where(c=>c!=""));
    }
    private static string? DominantWill(BattleSnapshot s,BattleSide side,bool mine)
    {
        var cards=side.Field.Where(m=>!m.IsSet).Select(m=>m.Card).Concat(side.Graveyard).Concat(mine?s.Hand.Select(h=>h.Card):[]);
        return cards.Select(c=>c.Will).Where(w=>!string.IsNullOrEmpty(w)&&w!="中立").GroupBy(w=>w).OrderByDescending(g=>g.Count()).ThenBy(g=>g.Key,StringComparer.Ordinal).Select(g=>g.Key).FirstOrDefault();
    }
    private RenderFragment HeroFace(BattleSide side,bool mine)=>@<div class="hero-face"><div class="hero-portrait"><img class="@(mine&&Profile.IsCustom?"custom":"")" src="@(mine?Profile.AvatarUrl:"battle/avatars/computer.svg")" alt="" draggable="false" /></div><span class="hero-crack" aria-hidden="true"></span><b class="hero-hp hp-value" @key="side.Hp" title="@L.F("生命 {0} / 7", side.Hp)">@side.Hp</b></div>;
    private bool CanDrag=>CanAct&&State?.Pending==null&&EnergyCandidate==null&&Detail==null&&!ShowHistory;
    private BattleHand? DragHand=>State?.Hand.FirstOrDefault(h=>h.Card.InstanceId==Dragging);
    private string[] AttackTargets=>State?.Player.Field.FirstOrDefault(m=>m.Card.InstanceId==Dragging)?.Targets.Select(t=>t.Id).ToArray()??[];
    private bool UntargetedDrag=>DragKind=="hand"&&DragHand is {CanPlay:true,PlayTargets.Length:0} h&&!SetModes.Contains(h.Card.InstanceId)&&h.Card.Type is not ("怪物" or "結界");
    private bool LegalZone(string zone)=>Dragging!=null&&(zone switch {"energy"=>DragKind=="hand"&&DragHand?.CanEnergy==true,"face"=>DragKind=="attack"&&AttackTargets.Contains("face")||UntargetedDrag,"center"=>UntargetedDrag,_=>false});
    private bool LegalSlot(bool mine,int slot,BattleMonster? m)=>State?.Pending?.Targets.Contains(m?.Card.InstanceId.ToString()??"")==true || (Dragging!=null&&(DragKind=="attack"?m!=null&&AttackTargets.Contains(m.Card.InstanceId.ToString()):DragHand is {} h && (SetModes.Contains(h.Card.InstanceId)?mine&&m==null&&h.CanSet:h.CanPlay&&(h.Card.Type is "怪物" or "結界"?mine&&m==null:m!=null&&h.PlayTargets.Contains(m.Card.InstanceId.ToString())))));
    private string HandClass(BattleHand h,bool back)=>!CanDrag?"inactive":back?(h.CanSet?"set-ready":"blocked"):h.CanPlay?"available":h.CanSet?"set-only":"blocked";
    private string HandLabel(BattleHand h,bool back)=>!CanAct?"等待行動":back?(h.CanSet?"可蓋牌 · 0費":"目前不能蓋牌"):h.CanPlay?"可出牌":h.CanSet?"只能蓋牌":"不可出牌";
    private string HandHint(BattleHand h,bool back)=>!CanAct?"等待你的行動時再出牌":back?(h.CanSet?"背面拖入己方空格，以0費蓋牌":"己方沒有可用格位或正在選擇效果"):h.CanPlay?"拖到亮起的合法位置出牌":h.Problem+(h.CanSet?"；右鍵可切換蓋牌，0費放入己方空格":"");
    private static string FanStyle(int i,int n){var offset=i-(n-1)/2.0;var angle=offset*Math.Min(5,34.0/Math.Max(1,n-1));return FormattableString.Invariant($"--offset:{offset:0.##};--step:min(100px,calc((100vw - 470px) / {Math.Max(1,n-1)}));--angle:{angle:0.##}deg;--rise:{Math.Abs(offset)*Math.Min(6,25.0/Math.Max(1,n-1)):0.##}px;--order:{i+1};--gaps:{Math.Max(1,n-1)}");}
    protected override void OnInitialized(){State=InitialResponse?.State??EffectiveBridge.Snapshot();Profile.Changed+=AvatarChanged;}
    private void AvatarChanged()=>_=InvokeAsync(()=>{if(!Disposed)StateHasChanged();});
    protected override async Task OnAfterRenderAsync(bool first){if(first){Preferences=await JS.InvokeAsync<IJSObjectReference>("import","./battle/preferences.js");ConfirmEnergy=await Preferences.InvokeAsync<bool>("readEnergyConfirmation");DragModule=await JS.InvokeAsync<IJSObjectReference>("import","./battle/fan-drag.js");Self=DotNetObjectReference.Create(this);DragBinding=await DragModule.InvokeAsync<IJSObjectReference>("bind",BoardElement,Self);SoundEnabled=await DragBinding.InvokeAsync<bool>("readSound");MotionReduced=await DragBinding.InvokeAsync<bool>("readMotion");StateHasChanged();if(InitialResponse!=null)await Publish(InitialResponse);await Ready.InvokeAsync();}}
    private async Task ToggleMotion(){if(DragBinding!=null)MotionReduced=await DragBinding.InvokeAsync<bool>("toggleMotion");}
    private async Task ToggleSound(){if(DragBinding!=null)SoundEnabled=await DragBinding.InvokeAsync<bool>("toggleSound");}
    private void OpenCard(BattleCard c){if(!TrainingToolsOpen)Detail=c;}
    private async Task OpenSlot(BattleMonster? m){if(m==null||TrainingToolsOpen)return;if(State?.Pending?.Targets.Contains(m.Card.InstanceId.ToString())==true)await Send("target",target:m.Card.InstanceId);else Detail=m.Card;}
    // Touch screens have no right click: the zoomed card offers the same face toggle.
    private void ToggleSetFromDetail(Guid id){Detail=null;ToggleSet(id);}
    private void ToggleSet(Guid id){if(!CanDrag)return;if(!SetModes.Remove(id))SetModes.Add(id);}
    private void HandKey(KeyboardEventArgs e,BattleCard c){if(e.Key is "Enter" or " ")OpenCard(c);if(e.Key=="s"||e.Key=="S")ToggleSet(c.InstanceId);}
    private async Task ActivateDetail(Guid id){Detail=null;await Send("activate",id);}
    [JSInvokable] public Task BeginDrag(string kind,string id){if(CanDrag&&Guid.TryParse(id,out var guid)){Dragging=guid;DragKind=kind;}return InvokeAsync(StateHasChanged);}
    [JSInvokable] public async Task DropCard(string kind,string id,string zone,int slot,string target)
    {
        Dragging=null;DragKind="";if(!CanDrag||!Guid.TryParse(id,out var guid)){if(DragBinding!=null)await DragBinding.InvokeVoidAsync("discardDrop");return;}
        Guid? targetId=Guid.TryParse(target,out var t)?t:null;
        if(kind=="attack"){
            var attacker=State!.Player.Field.FirstOrDefault(m=>m.Card.InstanceId==guid);
            if(attacker?.Targets.Any(t=>t.Id==(zone=="face"?"face":targetId?.ToString()))==true)await Send("attack",guid,zone=="face"?null:targetId);
            else Message="這裡不能攻擊，卡片已回到原位。";
        }else if(State!.Hand.FirstOrDefault(h=>h.Card.InstanceId==guid) is {} h){
            if(zone=="energy"&&h.CanEnergy)await Send("energy",guid);
            else if(SetModes.Contains(guid)){
                if(zone=="own"&&targetId==null&&slot>=0&&h.CanSet)await Place("set",guid,slot);else Message="蓋牌請拖到己方空格。";
            }else if(h.CanPlay){
                if(h.Card.Type is "怪物" or "結界"){
                    if(zone=="own"&&targetId==null&&slot>=0)await Place("play",guid,slot);else Message="請拖到己方空格。";
                }else if(targetId!=null&&h.PlayTargets.Contains(targetId.Value.ToString()))await Send("play",guid,targetId);
                else if(zone is "center" or "face" && h.PlayTargets.Length==0)await Send("play",guid);
                else Message="請拖到亮起的合法目標。";
            }else Message=h.Problem;
        }
        if(EnergyCandidate==null&&DragBinding!=null)await DragBinding.InvokeVoidAsync("discardDrop");
        await InvokeAsync(StateHasChanged);
    }
    private async Task CancelEnergy(){EnergyCandidate=null;if(DragBinding!=null)await DragBinding.InvokeVoidAsync("discardDrop");}
    [JSInvokable]public Task EndDrag(){Dragging=null;DragKind="";return InvokeAsync(StateHasChanged);}
    private async Task Place(string type,Guid id,int slot){await Send(type,id);if(State?.Pending?.Options.Any(o=>o.Id==$"SLOT:{slot}")==true)await Send("choice",option:$"SLOT:{slot}");}
    private async Task Send(string type,Guid? id=null,Guid? target=null,string? option=null,bool force=false)
    {
        if(Busy||Presenting||State==null)return;
        if(type=="energy"&&ConfirmEnergy&&!force){EnergyCandidate=id;return;}
        EnergyCandidate=null;Busy=true;
        try{
            // Slot selection completes placement; energy confirmation completes energy filling.
            var presentDrop=type is "energy" or "attack" || type=="choice"&&option?.StartsWith("SLOT:")==true
                || type=="play"&&State.Hand.FirstOrDefault(h=>h.Card.InstanceId==id)?.Card.Type is not ("怪物" or "結界");
            if(presentDrop&&DragBinding!=null){StateHasChanged();await DragBinding.InvokeVoidAsync("playDrop");}
            if(!Disposed)await Publish(EffectiveCoordinator.Submit(Presenter,new(Guid.NewGuid(),State.MatchId,State.Revision,type,id,target,option)));
        }
        finally{Busy=false;if(!Disposed)StateHasChanged();}
    }
    public async Task Publish(BattleResponse response)
    {
        if(Disposed)return;
        var previous=State;
        if(previous?.MatchId!=response.State.MatchId){History.Clear();SetModes.Clear();EnergyCandidate=null;ShowHistory=false;}
        Presenting=response.Success&&previous!=null&&previous.MatchId==response.State.MatchId&&previous.Revision!=response.State.Revision&&response.Events.Length>0&&DragBinding!=null;
        try{
            if(Presenting){
                StateHasChanged();
                try{await DragBinding!.InvokeVoidAsync("presentEvents",previous,response.State,LocalizeEvents(response.Events));}
                catch(JSException){await DragBinding!.InvokeVoidAsync("clearEvents");Presenting=false;}
            }
            if(Disposed)return;
            State=response.State;Message=response.Success?"":response.Message;Dragging=null;Detail=null;
            if(!response.Success&&DragBinding!=null)await DragBinding.InvokeVoidAsync("playError");
            SetModes.IntersectWith(State.Hand.Select(h=>h.Card.InstanceId));
            foreach(var ev in response.Events)History.Insert(0,new HistoryEntry(ev.Side=="player"?"我方":"敵方",ev.Label,ev.Card));
            if(History.Count>150)History.RemoveRange(150,History.Count-150);
            if(Presenting){StateHasChanged();if(!Disposed)await DragBinding!.InvokeVoidAsync("clearEvents");}
            if(!Disposed){EffectiveCoordinator.Acknowledge(Presenter,response.State.MatchId,response.State.Revision,response.BatchId);await Changed.InvokeAsync(State);}
        }
        finally{Presenting=false;if(!Disposed)StateHasChanged();}
    }
    public async ValueTask DisposeAsync(){Disposed=true;Profile.Changed-=AvatarChanged;if(DragBinding!=null){await DragBinding.InvokeVoidAsync("dispose");await DragBinding.DisposeAsync();}Self?.Dispose();if(DragModule!=null)await DragModule.DisposeAsync();if(Preferences!=null)await Preferences.DisposeAsync();}
}
