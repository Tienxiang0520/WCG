<div class="top-row navbar navbar-dark">
    <a class="navbar-brand fw-bold" href="" aria-label="魂誓首頁">
        <span aria-hidden="true">🔮</span><span class="brand-text">魂誓</span>
    </a>
    <button class="sidebar-toggle" type="button" @onclick="OnToggle"
            aria-label="@(Collapsed ? "展開側邊欄" : "收合側邊欄")"
            aria-expanded="@(!Collapsed ? "true" : "false")" aria-controls="main-navigation"
            title="@(Collapsed ? "展開側邊欄" : "收合側邊欄")">@(Collapsed ? "›" : "‹")</button>
    <button class="mobile-toggle" type="button" @onclick="ToggleMobileMenu"
            aria-label="@(mobileMenuOpen ? "收合選單" : "展開選單")"
            aria-expanded="@(mobileMenuOpen ? "true" : "false")" aria-controls="main-navigation">☰</button>
</div>

<div id="main-navigation" class="nav-scrollable @(mobileMenuOpen ? "mobile-open" : "")">
    <nav class="nav flex-column" aria-label="主選單">
        @foreach (var item in menuItems)
        {
            <div class="nav-item">
                <NavLink class="nav-link" href="@item.Href" Match="@item.Match" title="@item.Label"
                         aria-label="@item.Label" @onclick="CloseMobileMenu">
                    <span class="nav-icon" aria-hidden="true">@item.Icon</span>
                    <span class="nav-label">@item.Label</span>
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    [Parameter] public bool Collapsed { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }
    private bool mobileMenuOpen;
    private void ToggleMobileMenu() => mobileMenuOpen = !mobileMenuOpen;
    private void CloseMobileMenu() => mobileMenuOpen = false;
    private readonly (string Href, string Icon, string Label, NavLinkMatch Match)[] menuItems =
    [
        ("", "⚔️", "人機對戰測試", NavLinkMatch.All),
        ("ranked", "🏆", "天梯", NavLinkMatch.Prefix),
        ("deckbuilder", "🃏", "牌組構築室", NavLinkMatch.Prefix),
        ("cards", "📖", "完整卡牌圖鑑", NavLinkMatch.Prefix),
        ("rules", "📜", "官方遊戲規則", NavLinkMatch.Prefix),
        ("settings", "⚙️", "設定", NavLinkMatch.Prefix)
    ];
}
