@* DP 指示物 (重蹄碾壓): red round token with a hoof print and 「+1」, each one is +1 DP on the monster it sits on. *@
<svg class="@Class" viewBox="0 0 64 64" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
    <circle cx="32" cy="32" r="29" fill="@(Ink ? "#ffffff" : "#a3161a")" stroke="@(Ink ? "#000000" : "#4a0608")" stroke-width="3"/>
    <circle cx="32" cy="32" r="24" fill="none" stroke="@(Ink ? "#000000" : "#ffb3ad")" stroke-width="1.6"/>
    @* Cloven hoof: two toes side by side. *@
    <path d="M30 12 C21 12 17 22 18 31 C19 36 24 37 29 35 C30 34 30 33 30 31 Z" fill="@(Ink ? "#000000" : "#fff3ec")"/>
    <path d="M34 12 C43 12 47 22 46 31 C45 36 40 37 35 35 C34 34 34 33 34 31 Z" fill="@(Ink ? "#000000" : "#fff3ec")"/>
    <text x="32" y="53" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-size="15" font-weight="900" fill="@(Ink ? "#000000" : "#ffffff")">+1</text>
</svg>
@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Ink { get; set; }
}
