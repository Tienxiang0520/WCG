<Project>
  <!-- Both hosts must embed the same historical catalogs and translations with stable names. -->
  <ItemGroup>
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../WcgWeb/Data/balance-before-player-targets.json" LogicalName="WcgWeb.Balance.BeforePlayerTargets" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../WcgWeb/Data/balance-before-unlimited-faction-triggers.json" LogicalName="WcgWeb.Balance.BeforeUnlimitedFactionTriggers" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../WcgWeb/Data/balance-before-arrow-cards.json" LogicalName="WcgWeb.Balance.BeforeArrowCards" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../WcgWeb/Data/balance-before-card-text.json" LogicalName="WcgWeb.Balance.BeforeCardText" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../WcgWeb/Data/balance-before-diversity.json" LogicalName="WcgWeb.Balance.BeforeDiversity" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../WcgWeb/i18n/en.json" LogicalName="WcgWeb.I18n.en.json" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../WcgWeb/i18n/cards.en.json" LogicalName="WcgWeb.I18n.cards.en.json" WithCulture="false" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../WcgWeb/i18n/decks.en.json" LogicalName="WcgWeb.I18n.decks.en.json" WithCulture="false" />
  </ItemGroup>
</Project>
