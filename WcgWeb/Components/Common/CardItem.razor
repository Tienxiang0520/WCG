@namespace WcgWeb.Components.Common

<div class="wcg-card will-@Card.Will @(IsPlayable ? "is-playable" : "") @(IsSelected ? "is-selected" : "") card-hoverable @(Compact ? "compact-card" : "")"
     @onclick="HandleCardClick">
    
    <!-- Header -->
    <div class="card-header-bar">
        <span class="card-title" title="@Card.Name">@Card.Name</span>
        <div class="card-cost-gem" title="通用費用"><span class="gem-icon">@Card.TotalCost</span></div>
    </div>

    <!-- Art Box -->
    <div class="card-art-box">
        @if (QuantityInDeck >= 0)
        {
            <div class="position-absolute top-0 end-0 m-1" style="z-index: 5;">
                <span class="badge @(QuantityInDeck >= 4 && !Card.IsEnergy ? "bg-danger" : "bg-primary") rounded-pill shadow-sm" style="font-size: 0.65rem; padding: 2px 6px;">
                    @(Card.IsEnergy ? $"{QuantityInDeck} 張" : $"{QuantityInDeck}/4")
                </span>
            </div>
        }
        <CardArt Card="Card" />
        @foreach (var arrow in Card.Arrows)
        {
            <span class="card-art-arrow @arrow" aria-label="@(arrow == "left" ? "指向左鄰格" : arrow == "right" ? "指向右鄰格" : "指向正對面敵格")">@(arrow == "left" ? "←" : arrow == "right" ? "→" : "↑")</span>
        }
        <div class="card-type-strip">
            @Card.Type · @Card.Will
        </div>
    </div>

    <!-- Text / Ability Box -->
    <div class="card-text-box">
        @if (Card.IsMonster)
        {
            <div class="mb-1 d-flex flex-wrap gap-1">
                @if (Card.HasTaunt) { <span class="badge bg-secondary badge-status">嘲諷</span> }
                @if (Card.HasCharge) { <span class="badge bg-danger badge-status">衝鋒</span> }
                @if (Card.HasTrample) { <span class="badge bg-danger badge-status">貫穿</span> }
                @if (Card.HasDivineShield) { <span class="badge bg-warning text-dark badge-status">聖盾</span> }
                @if (Card.HasStealth) { <span class="badge bg-info text-dark badge-status">潛伏</span> }
                @if (Card.HasPoison) { <span class="badge bg-success badge-status">劇毒</span> }
            </div>
        }
        @if (string.IsNullOrWhiteSpace(Card.Text))
        {
            <div class="text-muted text-center fst-italic" style="font-size:0.68rem; margin:auto;">（純白凡骨）</div>
        }
        else
        {
            <div style="font-size: 0.72rem; line-height: 1.25;">@Card.Text</div>
        }
    </div>

    <!-- Footer Stats (Monster only) -->
    @if (Card.IsMonster)
    {
        <div class="card-footer-stats">
            <div class="stat-badge-pp" title="力量值 PP (戰鬥消滅判定)">
                <small>PP</small>@(Card.PP?.ToString() ?? "0")
            </div>
            <div class="stat-badge-dp" title="傷害值 DP (對玩家本體傷害)">
                <small>DP</small>@(Card.DP?.ToString() ?? "1")
            </div>
        </div>
    }



    @if (ShowPlayButton && IsPlayable)
    {
        <button class="btn btn-sm btn-success w-100 mt-1 py-0 fw-bold" style="font-size:0.75rem;"
                @onclick="HandlePlayClick" @onclick:stopPropagation="true">
            @(Card.IsMonster ? "召喚" : "施放")
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired] public CardDefinition Card { get; set; } = null!;
    [Parameter] public bool IsPlayable { get; set; } = false;
    [Parameter] public bool IsSelected { get; set; } = false;
    [Parameter] public bool Compact { get; set; } = false;
    [Parameter] public int QuantityInDeck { get; set; } = -1;
    [Parameter] public bool ShowPlayButton { get; set; } = false;
    [Parameter] public EventCallback OnCardClicked { get; set; }
    [Parameter] public EventCallback OnPlayClicked { get; set; }

    private async Task HandleCardClick()
    {
        if (OnCardClicked.HasDelegate)
        {
            await OnCardClicked.InvokeAsync();
        }
    }

    private async Task HandlePlayClick()
    {
        if (OnPlayClicked.HasDelegate)
        {
            await OnPlayClicked.InvokeAsync();
        }
    }

    public static string GetWillIcon(string will) => will switch
    {
        "狂怒" => "🔴",
        "理智" => "🔵",
        "生機" => "🟢",
        "秩序" => "🟡",
        "深淵" => "🟣",
        _ => "⚪"
    };

    public static string GetCardArtIcon(CardDefinition card)
    {
        if (card.IsEnergy) return card.Will switch
        {
            "狂怒" => "🔥",
            "理智" => "💧",
            "生機" => "🌿",
            "秩序" => "☀️",
            "深淵" => "🌌",
            _ => "💎"
        };

        if (card.IsSpell) return card.Will switch
        {
            "狂怒" => "💥",
            "理智" => "🔮",
            "生機" => "🍃",
            "秩序" => "✨",
            "深淵" => "🕳️",
            _ => "📜"
        };

        // Monsters by ID or Name
        if (card.Id == "WCG-120") return "🌋"; // Ragnaros
        if (card.Id == "WCG-097") return "👑"; // Sylvanas
        if (card.Id == "WCG-080") return "⚔️"; // Tirion
        if (card.Id == "WCG-060") return "🌳"; // Cenarius
        if (card.Id == "WCG-040") return "🧙‍♂️"; // Antonidas
        if (card.Id == "WCG-020") return "👹"; // Grommash
        if (card.Id == "WCG-116") return "🐉"; // Azure Drake
        if (card.Id == "WCG-108") return "⚙️"; // Harvest Golem

        if (card.Name.Contains("龍")) return "🐉";
        if (card.Name.Contains("熊") || card.Name.Contains("狼") || card.Name.Contains("豹")) return "🐾";
        if (card.Name.Contains("樹") || card.Name.Contains("林")) return "🌲";
        if (card.Name.Contains("惡魔") || card.Name.Contains("深淵") || card.Name.Contains("魔")) return "👿";
        if (card.Name.Contains("聖") || card.Name.Contains("騎士") || card.Name.Contains("衛")) return "🛡️";
        if (card.Name.Contains("法師") || card.Name.Contains("賢者") || card.Name.Contains("學者")) return "🧙";
        if (card.Name.Contains("狂") || card.Name.Contains("戰士") || card.Name.Contains("斧")) return "🪓";
        if (card.Name.Contains("弓") || card.Name.Contains("獵")) return "🏹";

        return card.Will switch
        {
            "狂怒" => "⚔️",
            "理智" => "🧊",
            "生機" => "🌱",
            "秩序" => "⚖️",
            "深淵" => "💀",
            _ => "🗿"
        };
    }
}
