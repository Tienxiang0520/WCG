@namespace WcgWeb.Components.Ranked
@using WcgWeb.Models.Ranked
@using WcgWeb.Models.Battle
@using WcgWeb.Components.Common
@implements IDisposable

<div class="replay-shade">
<section class="replay-viewer" role="dialog" aria-modal="true" aria-label="@L["對局回顧"]">
    <header class="replay-head">
        <div class="replay-title">
            <p class="replay-kicker">@L["對局回顧"]@(Record is { } rec ? " · " + L[RankedRules.Tiers[Math.Clamp(rec.Tier, 0, RankedRules.Tiers.Length - 1)]] + " · " + L[rec.PlayerFirst ? "先攻" : "後攻"] : "")</p>
            @if (Record is { } r)
            {
                <h2><span>@L.DeckName(r.PlayerDeck)</span><em>VS</em><span>@L.DeckName(r.ComputerDeck)</span></h2>
                <p class="replay-sub"><span class="replay-badge @(r.Won ? "won" : "lost")">@L[r.Won ? "勝利" : "敗北"]</span>@L.Text(RankedRules.Label(r.Before)) → @L.Text(RankedRules.Label(r.After)) · @L.F("{0} 回合", r.Turns)</p>
            }
        </div>
        <button type="button" class="replay-close" data-sfx="back" aria-label="@L["關閉回顧"]" @onclick="Close"><Icon Name="close" Size="18" /><span>@L["關閉"]</span></button>
    </header>
    @if (Replay == null)
    {
        <div class="replay-loading" role="status"><span class="replay-spinner"></span>@L["正在依照種子重新模擬對局…"]</div>
    }
    else
    {
        @if (Replay.Error != "") { <p class="replay-error" role="alert">@L.Text(Replay.Error)</p> }
        @if (Current is { } step)
        {
            var s = step.State;
            <div class="replay-body">
                <div class="replay-board" aria-label="@L.F("第 {0} 回合盤面", s.Turn)">
                    @Hero(s.Computer, false, s)
                    @Row(s.Computer, false)
                    <div class="replay-divider"><span>@L[s.ActivePlayerId == "player" ? "你的回合" : "電腦回合"]</span></div>
                    @Row(s.Player, true)
                    @Hero(s.Player, true, s)
                    <div class="replay-hand" aria-label="@L["你的手牌"]">
                        <span class="replay-zone">@L["手牌"]</span>
                        @if (s.Hand.Length == 0) { <span class="replay-empty">@L["（無）"]</span> }
                        @foreach (var h in s.Hand) { @Chip(h.Card, "hand") }
                    </div>
                </div>
                <aside class="replay-side">
                    <div class="replay-step-card" aria-live="polite">
                        <p class="replay-step-meta">@L["步驟"] <b class="wcg-num">@Index</b> / <span class="wcg-num">@(Replay.Steps.Count - 1)</span> · @L.F("第 {0} 回合", step.Turn)</p>
                        <p class="replay-step-title"><span class="replay-actor @step.Actor">@L[ActorLabel(step.Actor)]</span>@L[ActionLabel(step.Action)]</p>
                        <ul class="replay-events">
                            @if (step.Events.Length == 0) { <li class="replay-empty">@L["（沒有公開事件）"]</li> }
                            @foreach (var ev in step.Events.Take(24)) { <li>@Line(ev)</li> }
                        </ul>
                        @if (s.IsOver) { <p class="replay-outcome">@L.Text(s.Outcome)</p> }
                    </div>
                    <div class="replay-graves">
                        @foreach (var side in new[] { s.Player, s.Computer })
                        {
                            <div class="replay-grave"><span class="replay-zone">@L[side.Id == "player" ? "我方墓地" : "敵方墓地"] <small class="wcg-num">@side.Graveyard.Length</small></span>
                                @if (side.Graveyard.Length == 0) { <span class="replay-empty">@L["（無）"]</span> }
                                @foreach (var c in side.Graveyard) { @Chip(c, "grave") }
                            </div>
                        }
                    </div>
                    <details class="replay-log">
                        <summary>@L["完整紀錄（至目前步驟）"]</summary>
                        <ol>
                            @foreach (var (n, ev) in Log().Take(120)) { <li><small class="wcg-num">#@n</small>@Line(ev)</li> }
                        </ol>
                    </details>
                </aside>
            </div>
            <footer class="replay-controls" aria-label="@L["回顧控制"]">
                <input type="range" class="replay-scrub" min="0" max="@(Replay.Steps.Count - 1)" value="@Index" aria-label="@L["步驟"]" @onchange="Scrub" />
                <div class="replay-buttons">
                    <button type="button" data-sfx="back" aria-label="@L["回到開局"]" title="@L["回到開局"]" disabled="@(Index == 0)" @onclick="() => Go(0)"><Icon Name="skip-back" Size="18" /></button>
                    <button type="button" data-sfx="select" aria-label="@L["上一步"]" title="@L["上一步"]" disabled="@(Index == 0)" @onclick="() => Go(Index - 1)"><Icon Name="chevron-left" Size="20" /></button>
                    <button type="button" class="replay-play" data-sfx="@(Playing ? "toggleOff" : "toggleOn")" aria-label="@L[Playing ? "暫停" : "播放"]" aria-pressed="@(Playing ? "true" : "false")" disabled="@(Replay.Steps.Count < 2)" @onclick="TogglePlay"><Icon Name="@(Playing ? "pause" : "play")" Size="22" /><span>@L[Playing ? "暫停" : "播放"]</span></button>
                    <button type="button" data-sfx="select" aria-label="@L["下一步"]" title="@L["下一步"]" disabled="@(Index >= Replay.Steps.Count - 1)" @onclick="() => Go(Index + 1)"><Icon Name="chevron-right" Size="20" /></button>
                    <button type="button" data-sfx="select" aria-label="@L["跳到結局"]" title="@L["跳到結局"]" disabled="@(Index >= Replay.Steps.Count - 1)" @onclick="() => Go(Replay.Steps.Count - 1)"><Icon Name="skip-forward" Size="18" /></button>
                </div>
                <div class="replay-speed segmented" role="radiogroup" aria-label="@L["播放速度"]">
                    @foreach (var sp in Speeds) { <button type="button" role="radio" aria-checked="@(Speed == sp ? "true" : "false")" class="@(Speed == sp ? "on" : "")" @onclick="() => Speed = sp">@(sp)×</button> }
                </div>
            </footer>
            @if (Cue != "") { <span hidden @key="CueKey" data-sfx-show="@Cue" data-sfx-delay="0"></span> }
        }
    }
</section>
</div>
<CardPreviewDialog Card="Detail" OnClose="() => Detail = null" />

@code {
    [Parameter] public RankedRecord? Record { get; set; }
    [Parameter] public RankedReplay? Replay { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    private static readonly double[] Speeds = [0.5, 1, 2, 4];
    private int Index;
    private double Speed = 1;
    private bool Playing;
    private BattleCard? Detail;
    private string Cue = "";
    private int CueKey;
    private CancellationTokenSource? Loop;
    private RankedReplay? Seen;
    private RankedReplayStep? Current => Replay is { Steps.Count: > 0 } r ? r.Steps[Math.Clamp(Index, 0, r.Steps.Count - 1)] : null;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(Seen, Replay)) return;
        Seen = Replay; Index = 0; Stop(); Cue = "";
    }
    private void Scrub(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var n)) Go(n); }
    private void Go(int n)
    {
        if (Replay == null || Replay.Steps.Count == 0) return;
        Index = Math.Clamp(n, 0, Replay.Steps.Count - 1); Detail = null;
        if (Index == Replay.Steps.Count - 1) Stop();
    }
    private void TogglePlay()
    {
        if (Playing) { Stop(); return; }
        if (Replay == null || Replay.Steps.Count < 2) return;
        if (Index >= Replay.Steps.Count - 1) Index = 0;
        Playing = true; Loop = new(); _ = Run(Loop.Token);
    }
    private async Task Run(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested && Replay != null && Index < Replay.Steps.Count - 1)
            {
                await Task.Delay(TimeSpan.FromMilliseconds(Math.Max(150, 1200 / Speed)), token);
                await InvokeAsync(() =>
                {
                    if (token.IsCancellationRequested || Replay == null || Detail != null) return;
                    Index++; Cue = StepCue(Replay.Steps[Index]); CueKey++;
                    if (Index >= Replay.Steps.Count - 1) Playing = false;
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) { }
    }
    private void Stop() { Playing = false; Loop?.Cancel(); Loop?.Dispose(); Loop = null; }
    private async Task Close() { Stop(); await OnClose.InvokeAsync(); }
    public void Dispose() => Stop();

    // During autoplay one representative sound per step, using the same cue names as the live board.
    private static readonly (string Type, string Cue)[] CueOrder =
        [("gameover", "gameover"), ("death", "death"), ("attack", "attack"), ("damage", "damage"), ("summon", "summon"), ("play", "place"), ("set", "set"), ("heal", "heal"), ("energy", "energy"), ("turn", "turn"), ("draw", "draw")];
    private static string StepCue(RankedReplayStep step) =>
        CueOrder.FirstOrDefault(c => step.Events.Any(e => e.Type == c.Type)).Cue ?? "select";
    private IEnumerable<(int, BattleEvent)> Log()
    {
        if (Replay == null) yield break;
        for (var i = Math.Min(Index, Replay.Steps.Count - 1); i >= 0; i--)
            foreach (var ev in Replay.Steps[i].Events.Reverse()) yield return (i, ev);
    }
    private static string ActorLabel(string actor) => actor switch { "computer" => "電腦", "player" => "你", _ => "開局" };
    private static string ActionLabel(string action) => action switch
    {
        "start" => "洗牌、決定先後手並抽起手牌", "ai" => "行動", "energy" => "放置能量", "end" => "結束回合", "play" => "出牌",
        "set" => "蓋牌", "attack" => "宣告攻擊", "target" => "選擇目標", "option" => "選擇效果", "cancel" => "取消選擇",
        "activate" => "發動結界", "surrender" => "投降", _ => action
    };
    private RenderFragment Line(BattleEvent ev) => __builder =>
    {
        <span class="replay-line-side @(ev.Side == "player" ? "mine" : "theirs")">@(ev.Side == "player" ? L["我方"] : ev.Side == "computer" ? L["敵方"] : "")</span>
        <span>@L.Text(ev.Label)</span>
        if (ev.Card is { } c && c.CardId != "SET" && c.Name != "") { @Chip(c, "log") }
    };
    private RenderFragment Chip(BattleCard c, string kind) => __builder =>
    {
        if (c.CardId == "SET" || c.Name == "")
        {
            <span class="replay-chip back" title="@L["蓋牌（未公開）"]">@L["蓋牌"]</span>
        }
        else
        {
            <button type="button" class="replay-chip @kind" data-sfx="flip" title="@L.F("查看 {0}", L.CardName(c))" @onclick="() => Open(c)">@L.CardName(c)</button>
        }
    };
    private void Open(BattleCard c) { Detail = c; if (Playing) Stop(); }
    private RenderFragment Hero(BattleSide side, bool mine, BattleSnapshot s) => __builder =>
    {
        <div class="replay-hero @(mine ? "mine" : "theirs") @(s.ActivePlayerId == side.Id ? "active" : "")">
            <strong>@L[mine ? "你" : "電腦"]</strong>
            <span class="replay-stat hp" title="@L["生命"]"><Icon Name="heart" Size="14" /><b class="wcg-num">@side.Hp</b></span>
            <span class="replay-stat" title="@L["能量"]"><Icon Name="bolt" Size="14" /><b class="wcg-num">@side.AvailableEnergy/@side.TotalEnergy</b></span>
            <span class="replay-stat" title="@L["手牌"]">@L["手牌"] <b class="wcg-num">@side.HandCount</b></span>
            <span class="replay-stat" title="@L["牌庫"]">@L["牌庫"] <b class="wcg-num">@side.DeckCount</b></span>
        </div>
    };
    private RenderFragment Row(BattleSide side, bool mine) => __builder =>
    {
        <div class="replay-row @(mine ? "mine" : "theirs")">
            @for (var screen = 0; screen < 5; screen++)
            {
                var slot = mine ? screen : 4 - screen; var m = side.Field.FirstOrDefault(x => x.Slot == slot);
                @if (m == null) { <div class="replay-slot vacant"><small>@(slot + 1)</small></div> }
                else if (m.IsSet || m.Card.CardId == "SET")
                {
                    <div class="replay-slot set" title="@L["蓋牌（未公開）"]"><div class="replay-back">@L["魂"]<br />@L["誓"]</div></div>
                }
                else
                {
                    <button type="button" class="replay-slot unit @(m.Tapped ? "tapped" : "") @(m.Status.Contains("嘲諷") ? "taunt" : "")" data-sfx="flip" title="@L.F("查看 {0}", L.CardName(m.Card))" @onclick="() => Open(m.Card)">
                        <span class="replay-art"><CardImage CardId="@m.Card.CardId" /></span>
                        <span class="replay-name">@L.CardName(m.Card)</span>
                        @if (m.Card.PP != null) { <span class="replay-pp wcg-num">@m.PP</span><span class="replay-dp wcg-num">@m.DP</span> }
                    </button>
                }
            }
        </div>
    };
}
