<button @ref="Trigger" id="@Id" type="button" class="form-select deck-picker-trigger" aria-haspopup="dialog" aria-expanded="@Open" disabled="@Disabled" @onclick="Show">
    @(Selected is { } deck ? L.DeckName(deck) : L["選擇牌組"])
</button>
@if (Open)
{
    <div class="deck-picker-backdrop" @onclick="Close">
        <section @ref="Dialog" class="deck-picker-dialog" role="dialog" aria-modal="true" aria-labelledby="@(Id + "-title")" tabindex="-1" @onclick:stopPropagation @onkeydown="KeyDown">
            <header><h2 id="@(Id + "-title")">@Label</h2><button type="button" aria-label="@L["關閉"]" @onclick="Close">×</button></header>
            <div class="deck-picker-list">
                @foreach (var item in Decks)
                {
                    var valid = item.IsValid(Cards.GetCard, out _);
                    <button type="button" class="deck-picker-option @(item.Id == Value ? "selected" : "")" disabled="@(!valid)" aria-pressed="@(item.Id == Value)" @onclick="() => Choose(item.Id)">
                        <strong>@L.DeckName(item)</strong><small>@L[item.MainWill] · @L.F("{0} 張", item.CardIds.Count) @(!valid ? L["需重新編輯"] : "")</small>
                    </button>
                }
                @if (Decks.Count == 0) { <p>@L["尚無自訂牌組，請到組牌頁建立或複製牌組。"]</p> }
            </div>
            @if (ShowEditorLink) { <footer><a href="deckbuilder" class="btn btn-outline-info">@L["編輯或複製牌組"]</a></footer> }
        </section>
    </div>
}
@inject CardDatabase Cards
@inject IJSRuntime JS
@implements IAsyncDisposable
@code {
    [Parameter] public string Id { get; set; } = "deck-picker";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public IReadOnlyList<Deck> Decks { get; set; } = [];
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ShowEditorLink { get; set; } = true;
    private Deck? Selected => Decks.FirstOrDefault(d => d.Id == Value);
    private bool Open, AttachPending;
    private ElementReference Trigger, Dialog;
    private IJSObjectReference? Module, Handle;
    private void Show() { Open = true; AttachPending = true; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!AttachPending || !Open) return;
        AttachPending = false;
        Module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./deck-picker.js");
        Handle = await Module.InvokeAsync<IJSObjectReference>("attach", Dialog);
        await Dialog.FocusAsync();
    }
    private async Task Close()
    {
        Open = false;
        if (Handle != null) { await Handle.InvokeVoidAsync("dispose"); await Handle.DisposeAsync(); Handle = null; }
        await Trigger.FocusAsync();
    }
    private async Task Choose(string id) { await ValueChanged.InvokeAsync(id); await Close(); }
    private Task KeyDown(KeyboardEventArgs e) => e.Key == "Escape" ? Close() : Task.CompletedTask;
    public async ValueTask DisposeAsync()
    {
        try
        {
            if (Handle != null) { await Handle.InvokeVoidAsync("dispose"); await Handle.DisposeAsync(); }
            if (Module != null) await Module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}
