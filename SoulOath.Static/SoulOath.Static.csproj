<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WcgWeb</RootNamespace><PublishTrimmed>false</PublishTrimmed><JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault><OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../WcgWeb/Data/balance-before-unlimited-faction-triggers.json" LogicalName="WcgWeb.Balance.BeforeUnlimitedFactionTriggers" />
    <EmbeddedResource Include="../WcgWeb/Data/balance-before-arrow-cards.json" LogicalName="WcgWeb.Balance.BeforeArrowCards" />
    <EmbeddedResource Include="../WcgWeb/i18n/en.json" LogicalName="WcgWeb.I18n.en.json" />
    <EmbeddedResource Include="../WcgWeb/i18n/cards.en.json" LogicalName="WcgWeb.I18n.cards.en.json" WithCulture="false" />
    <EmbeddedResource Include="../WcgWeb/i18n/decks.en.json" LogicalName="WcgWeb.I18n.decks.en.json" WithCulture="false" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
    <Compile Include="../WcgWeb/Models/**/*.cs" Link="Models/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../WcgWeb/Services/**/*.cs" Exclude="../WcgWeb/Services/Hosting/**/*.cs" Link="Services/Shared/%(RecursiveDir)%(Filename)%(Extension)" />
    <RazorComponent Include="../WcgWeb/Components/**/*.razor"
      Exclude="../WcgWeb/Components/App.razor;../WcgWeb/Components/Routes.razor;../WcgWeb/Components/Common/CardArt.razor;../WcgWeb/Components/Layout/ReconnectModal.razor;../WcgWeb/Components/Pages/Error.razor;../WcgWeb/Components/Pages/Settings.razor;../WcgWeb/Components/Pages/BattleLab.razor"
      Link="Components/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="../WcgWeb/Components/**/*.razor.css" Exclude="../WcgWeb/Components/Layout/ReconnectModal.razor.css;../WcgWeb/Components/Pages/Settings.razor.css" Link="Components/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="PreparePublicGameAssets" BeforeTargets="PrepareForBuild">
    <Exec Command="node tools/prepare-assets.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <ItemGroup>
      <Content Include="wwwroot/**/*" Exclude="@(Content)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
